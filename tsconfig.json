{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0" // ignore the deprecation warnings for baseURL
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist/"]
}
