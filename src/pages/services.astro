---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features3 from '~/components/widgets/Features3.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';

const metadata = {
  title: 'Custom Software Development Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="From Tides to Triumph"
    title="Transform Your Business with the Power of Digital"
    subtitle="We partner with ambitious entrepreneurs, daring startups, and forward-thinking companies to reinvent their business models from the ground up. By fusing cutting-edge technology — AI agents, intelligent automation, predictive analytics, and next-generation workflows — with strategic insight, we don't just help you keep pace with change; we set you leagues ahead of it."
    actions={[{ variant: 'primary', text: 'Start exploring', icon: 'tabler:rocket', href: '#core-services' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'We offer Digital Services across Northern Ireland',
      class: 'grayscale hover:grayscale-0 rounded shadow-lg'
    }}
  />

  <!-- Features2 Widget ************** 
  
        call-to-actions = [
        {
          text = "Start Your Project",
          href = "#contact",
          variant = "primary"
        },
        {
          text = "Book a Discovery Call",
          href = "#contact",
          variant = "secondary"
        }
      ],
  
  
  -->



  <Features2
    tagline="Your Vision, Our Journey",
    title="Custom Software Engineering for bold Startups, forward-thinking Entrepreneurs, and growing Businesses",
    subtitle="Some ventures need a spark. Others demand a voyage. At CausewaySoft, we shape our engagement to match your ambition — from lightning-fast product launches to full-scale transformations that reforge the way you do business.",
    items={[
      {
        title: "Strategic Partnership",
        description: "Like the stones of the Causeway, strong relationships are built piece by piece. We work as an extension of your team — not just delivering code, but helping shape your roadmap, refine your ideas, and make decisions that will carry your business into the future.",
        icon: 'tabler:heart-handshake',
      },
      {
        title: "Digital Business Transformation",
        description: "For companies ready to evolve, we go beyond development. We reimagine your workflows, integrate AI and automation, and create systems that turn complexity into clarity — ensuring your business doesn’t just survive the next wave of change, but commands it.",
        icon: 'tabler:transaction-dollar',
      },
      {
        title: "From Idea to Impact: Fast, Goal-Driven MVP Launch",
        description: "When speed matters, we deliver. Using lean methods and rapid iteration, we get your Minimum Viable Product into the hands of users fast — so you can test, learn, and grow without wasting a single tide.",
        icon: 'tabler:trophy',
      }
    ]}
    >

  </Features2>

  <Features2
      id="core-services"
      tagline = "Explore Our Core Services",
      title = "Bring your ideas to life with our services.",
      subtitle = "From the spirit of the Giant’s Causeway, we forge digital experiences that blend heritage, ambition, and cutting-edge technology. Whether you’re launching your first product or transforming your business, our services are built to help visionaries succeed.",
      columns={3},

      items = {[
        {
          title: "Web Applications",
          description:"From MVP to full-scale platforms, we engineer dynamic, high-performance web apps that scale with your ambition — clean code, solid architecture, and endless potential.",
          icon: 'tabler:app-window',
          link: '/services/web-applications',
          callToAction:
          {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/web-applications',
            target: '_blank',
          }
        },
        {
          title:"Progressive Web Apps (PWAs)",
          description:"Blending the best of web and native, our PWAs are lightning-fast, offline-ready, and immersive — giving users an app-like experience without the app store friction.",
          icon: 'tabler:rocket',
          callToAction:
          {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/progressive-web-apps',
            target: '_blank',
          }
        },
        {
          title:"Hybrid Mobile Apps",
          description:"One build, many platforms. With React Native and modern stacks, we deliver cross-platform apps that feel native, run fast, and keep costs lean.",
          icon: 'tabler:device-mobile-star',
          callToAction:
          {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/hybrid-apps',
            target: '_blank',
          }
        },
        {
          title: "Websites",
          description: "From sleek portfolio sites to high-converting business platforms, we build websites that are great looking, extremely fast, and strategically designed to grow your brand. Each site is optimized for performance, SEO, and user experience — and can be paired with AI-powered chat agents to turn visitors into leads, bookings, and loyal customers.",
          icon: 'tabler:world-www',
          callToAction:
          {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/websites',
            target: '_blank',
          }
        },
        {
          title: "AI-Powered Solutions",
          description: "From chatbots and intelligent automation to predictive analytics — we build AI into your apps to make them smarter, faster, and more intuitive.",
          icon: 'tabler:ai',
          callToAction: {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/ai-agents-solutions',
            target: '_blank',
          }
        },
        {
          title: "Digital Business Transformations",
          description: "Reinvent your business model with cutting-edge tech like AI agents, workflow automation, and data-driven decision systems. We help you leap ahead, not just keep up.",
          icon: 'tabler:transaction-dollar',
          callToAction: {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/digital-business-transformations',
            target: '_blank',
          }
        },
        {
          title: "Chrome Extensions",
          description: "Compact yet powerful tools that integrate seamlessly with browsers, improving productivity and engagement for your users.",
          icon: 'tabler:brand-chrome',
          callToAction: {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/chrome-extensions',
            target: '_blank',
          }
        },
        {
          title: "UI/UX Design & Strategy",
          description: "We craft intuitive interfaces and seamless user journeys — turning casual users into loyal advocates.",
          icon: 'tabler:palette',
          callToAction: {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/ui-ux-strategy',
            target: '_blank',
          }
        },
        {
          title: "Hosting",
          description: "Our hosting solutions, located in the EU, UK, and Northern Ireland, deliver speed, security, and compliance. Keep your apps and websites online, resilient, and close to home.",
          icon: 'tabler:server-spark',
          callToAction: {
            variant: 'link',
            text: 'Learn more ...',
            href: '/services/hosting-solutions',
            target: '_blank',
          }
        },
        // {
        //   title: "NI Cloud-Hosted GPT Models",
        //   description: "Enterprise-grade GPT chatbots hosted securely in Northern Ireland. Tailored to your needs, protected by local compliance, and ready to transform how your business communicates.",
        //   icon: 'tabler:cloud'
        // }
      ]} 
        
  />

  <!-- Content Widget 
        image source: https://unsplash.com/photos/men-sitting-in-front-of-their-laptop-computer-MChSQHxGZrQ

  **************** -->

  <Content
    isReversed
    tagline="Why Choose Our Software Development Services",
    tagline="Why Choose Our Services",
    title="CausewaySoft Stands Above the Rest",
    subtitle="Most agencies will build you what you ask for. We go further. Like the builders of the Giant’s Causeway, we craft with purpose, precision, and a vision for the ages. Where others deliver a product, we deliver a launchpad for your ambitions. We don’t just write code — we help you write your legacy.",
    items={[
      { title: "Vision-First Approach", description: "We align our work with your long-term goals, not just the immediate brief.", icon: "tabler:eye" },
      { title: "Mythic Inspiration", description: "Our roots in the Giant’s Causeway fuel a mindset where challenges become stepping stones.", icon: "tabler:mountain" },
      { title: "Fewer Projects, More Focus", description: "We take on fewer clients so we can give each project the attention it deserves.", icon: "tabler:focus" },
      { title: "Seamless Collaboration", description: "Clear, frequent communication with transparency at every step.", icon: "tabler:arrows-right-left" },
      { title: "Proven Results", description: "A track record of delivering products that perform, scale, and impress.", icon: "tabler:check" }
    ]},
    image={{
      src: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=870&q=80',
      alt: 'Features Image',
    }}
  >
    <!-- <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Main Features</h3>
    </Fragment> -->
  </Content>

  <!-- Content Widget
    image source: https://unsplash.com/photos/boy-in-front-of-computer-monitor-vJP-wZ6hGBg

  **************** -->

  <Content
    isAfterContent
    tagline="What We Provide in Every Service",
    title="Excellence in Every Build",
    items={[
      { title: "Excellence in Engineering", description: "Clean, maintainable, high-performance code.", icon: "tabler:code" },
      { title: "Optimized for Success", description: "SEO-friendly, fast-loading, and responsive on all devices.", icon: "tabler:rocket" },
      { title: "Attention to Detail", description: "Every interaction, animation, and micro-feature is considered.", icon: "tabler:details" },
      { title: "Security & Privacy", description: "Built with modern security best practices from day one.", icon: "tabler:lock" },
      { title: "Scalability", description: "Architecture designed to grow with your business.", icon: "tabler:arrows-up-right" },
      { title: "Post-Launch Support", description: "We’re with you beyond deployment to keep everything running flawlessly.", icon: "tabler:lifebuoy" }
    ]},
    image={{
      src: 'https://images.unsplash.com/photo-1536148935331-408321065b18?auto=format&fit=crop&w=774&q=80',
      alt:  "Image showing a Software Engineer using high quality tools.",
    }}
  >
  </Content>


  <!-- Content Widget 

    image credit: https://unsplash.com/photos/a-laptop-computer-sitting-on-top-of-a-desk-nBXwqxjDa5c

  **************** -->
  <Content
    isAfterContent
    tagline="Our Tech Stack",
    title="Modern Tools for Legendary Results",
    items={[
      { title: "Frontend", description: "Vue, React, Next.js, Astro, Tailwind CSS, HTML5, CSS3, JavaScript (ES6+), TypeScript", icon: "tabler:layout" },
      { title: "Backend", description: "C# .NET, TypeScript, Node.js, Express, Python, PostgreSQL, MongoDB, GraphQL", icon: "tabler:server" },
      { title: "Mobile & Cross-Platform", description: "React Native, Progressive Web Apps (PWA)", icon: "tabler:device-mobile" },
      { title: "AI & Automation", description: "OpenAI GPT integration, custom AI agents, workflow automation", icon: "tabler:cpu" },
      { title: "3rd Party Integrations", description: "Shopify API, Zappier, Wordpress API", icon: "tabler:play-card-3" },
      { title: "Hosting & Infrastructure", description: "EU/UK-based servers, NI-hosted GPT models, AWS, Vercel, DigitalOcean", icon: "tabler:cloud" },
      { title: "DevOps & CI/CD", description: "GitHub Actions, Docker, Kubernetes (on request)", icon: "tabler:settings" },
      { title: "Project Management", description: "Git, Agile, Scrum, MS Dev Ops, Jirra", icon: "tabler:calendar" }
    ]},
    image={{
      src: 'https://images.unsplash.com/photo-1692106979244-a2ac98253f6b??q=70&w=690&auto=format&fit=crop',
      alt: 'Image of a MacBook laptop with Visual Studio Code opened, presenting moder software engineering tools being used.',
    }}
  >
  </Content>


  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Words from real customers"
    testimonials={[
      {
        title: 'Simple Business Website for a local Cleaning Business',
        testimonial: "I came to CausewaySoft, with a simple goal in mind, to show up online. I needed a simple and cost effective website for my cleaning business. They built me a beautiful website, and did initial marketing of it. Overtime, I noticed more customers telling me they found me online! It's made a massive difference to my confidence as a business owner and helped me elevate the quality of business that I get.",
        name: "Betty's Cleaning",
        job: 'Local Cleaning Agency | Coleraine Area',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Emily Kennedy Image',
        },
      },
      {
        title: 'Corporate Client – Custom Login Screen with CMS',
        testimonial: "We needed a polished, branded login page with the ability to easily update hero images and links. CausewaySoft delivered a solution that looked amazing and was incredibly simple for our team to manage. They understood our vision, nailed the design, and made the process smooth from start to finish.",
        name: 'Martin ....',
        job: 'IT Project Manager | Expro',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Sarah Hansen Image',
        },
      },
      {
        title: 'Medium-Sized Corporation – Real-Time Group Chat Integration',
        testimonial: "Our engineering teams needed a better way to collaborate while working on the same SCADA dashboards. CausewaySoft integrated a seamless, real-time group chat right into our existing web app. Now our engineers can troubleshoot, share insights, and solve problems faster — all without leaving the dashboard. It's been a game-changer for our workflow.",
        name: 'Mark Wilkinson',
        job: 'IT Project Manager | MeasureSoft',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: 'Mark Wilkinson Image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'More testimonials...',
      href: 'https://github.com/onwidget/astrowind',
      icon: 'tabler:chevron-right',
    }}
  />




    <!-- Features3 Widget 
     
    '6 Reasons why Us'
    
    ************** -->

  <Features3
    tagline='6 Reasons why'
    title="We are your #1 Custom Software Development Agency"
    subtitle="At CausewaySoft, we believe your software should be as unique as your business. That’s why we combine custom-built solutions, direct collaboration, and full-spectrum expertise to deliver results that fit perfectly — and last. With competitive rates, modern scalable tech, and clear communication every step of the way, we make your vision a reality without compromise."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        "title": "Truly Bespoke Development",
        "description": "We design and build every project from the ground up, avoiding cookie-cutter templates and focusing on your exact requirements.",
        "icon": "tabler:code"
      },
      {
        "title": "Direct Access to the Developer",
        "description": "You work with the person actually writing your code, which means faster communication, fewer misunderstandings, and more flexibility.",
        "icon": "tabler:user-code"
      },
      {
        "title": "Full-Service Expertise",
        "description": "We handle the entire process — UI/UX, backend, mobile, DevOps, and even product management — so you don't need multiple vendors.",
        "icon": "tabler:layers-intersect"
      },
      {
        "title": "High Quality at Competitive Rates",
        "description": "We are a lean, independent setup keeps overhead low, allowing you to get premium quality without enterprise-level pricing.",
        "icon": "tabler:currency-pound"
      },
      {
        "title": "Long-Term Scalability",
        "description": "We use modern, maintainable frameworks so your website or app can grow with your business.",
        "icon": "tabler:arrows-diagonal"
      },
        {
        "title": "Transparent Communication",
        "description": "We maintain open, honest, and regular communication throughout the project, so you're always informed and in control.",
        "icon": "tabler:messages"
      }
    ]}
  />



  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into how we build the apps."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      { title: "How long does it take to build a custom web or mobile app?", description: "Timelines vary depending on complexity, but MVPs typically launch within 6–12 weeks, with larger projects taking longer. We focus on rapid iteration without sacrificing quality.", icon: "tabler:calendar" },
      { title: "What’s included in your post-launch support?", description: "We offer maintenance, updates, bug fixes, and performance monitoring to ensure your product runs smoothly long after launch.", icon: "tabler:tool" },
      { title: "Do you work with international clients?", description: "Yes — while based in Northern Ireland, we work with ambitious clients across the UK, EU, USA, and beyond.", icon: "tabler:world" },
      { title: "Can you integrate AI into my app or website?", description: "Absolutely. We specialize in integrating AI chatbots, automation tools, and AI-driven analytics to give you a competitive edge.", icon: "tabler:robot" },
      { title: "How much does a custom software project cost?", description: "Costs depend on scope, features, and timelines. We offer transparent, milestone-based pricing so you know exactly what you’re paying for.", icon: "tabler:currency-pound" },
      { title: "What industries do you serve?", description: "We work with startups, entrepreneurs, and SMEs across sectors — from e-commerce and SaaS to local service businesses and enterprise solutions.", icon: "tabler:building" }
    ]}
  />


  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Let us help you Excel your Business using Custom Software Solutions"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: "Where shall our reply find you?"
      },
    ]},
    textarea={{
      label: 'Message',
      placeholder: "Tell us your challenges, dreams, or sparks"
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours.",
    button='Send Your Message'

    items={[
       {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading'
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        classes: {ctaLinks: 'emailLink'},
        href: 'enable javascript...',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        href: '+1 (234) 567-890',
        classes: {ctaLinks: 'phoneLink'},
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />


  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Schedule a Discovery Call',
        href: '',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      🚀 Launch Your Legend
    </Fragment>

    <Fragment slot="subtitle">
      Whether you’re building a unicorn or laying the first stone — we believe in your vision. We’re here to bring it to life with passion, power, and precision.
      <br/>
      Let’s build something <span class="font-bold">remarkable<span/> together.
    </Fragment>
  </CallToAction>
</Layout>
