---
/**
 * Services: a short router page, not a catalogue.
 * Plan: docs/services-restructure-plan.md (phase 3)
 *
 * Two services, each listing its sections as anchor links. AI and
 * automation are part of both rather than a service of their own.
 */
import Layout from '~/layouts/PageLayout.astro';

import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/components/home/basalt.css';

import BasaltHeader from '~/components/home/BasaltHeader.astro';
import BasaltFooter from '~/components/home/BasaltFooter.astro';
import ClosingCta from '~/components/home/ClosingCta.astro';
import { bookingHref, innerNavItems, footerLinks, headerCta } from '~/components/home/nav';

const metadata = {
  title: 'Services: websites, web applications & custom software',
  description:
    'Two services from an independent studio in Belfast: websites that win you business, and web applications and custom software that build a product or improve how your business operates.',
};

const services = [
  {
    index: '01',
    title: 'Websites',
    promise: 'Win more enquiries, bookings and customers.',
    description:
      'Fast, persuasive websites for local businesses, startups and growing companies, whether you need a new site or want to fix the one you have.',
    href: '/services/websites',
    sections: [
      { text: 'Business websites', href: '/services/websites#business-websites' },
      { text: 'E-commerce', href: '/services/websites#ecommerce' },
      { text: 'AI-enhanced websites', href: '/services/websites#ai' },
    ],
  },
  {
    index: '02',
    title: 'Web applications & custom software',
    promise: 'Build a digital product. Improve how your business operates.',
    description:
      'Custom software that runs in the browser, from a founder’s first MVP to the portals, tools and automation an established business runs on.',
    href: '/services/web-applications',
    sections: [
      { text: 'Business applications', href: '/services/web-applications#business-applications' },
      { text: 'SaaS & MVP development', href: '/services/web-applications#saas-mvp' },
      { text: 'Progressive Web Apps', href: '/services/web-applications#pwa' },
      { text: 'AI-powered features', href: '/services/web-applications#ai' },
      { text: 'Business automation', href: '/services/web-applications#automation' },
    ],
  },
];

// The other services' links for the footer row, minus "All services" (we're on it)
const footerServices = [
  { text: 'Websites', href: '/services/websites' },
  { text: 'Web applications', href: '/services/web-applications' },
];
---

<Layout metadata={metadata}>
  <BasaltHeader slot="header" items={innerNavItems} cta={headerCta} bookingHref={bookingHref} />

  <div class="bs">
    <!-- Intro -->
    <section class="sintro" aria-labelledby="services-title">
      <div class="bs-wrap">
        <div class="sintro__meta bs-mono">
          <p>Services · Belfast, Northern Ireland</p>
          <p>Websites · Web applications</p>
        </div>
        <h1 id="services-title" class="sintro__title bs-display">
          <span class="sintro__line">Two services.</span>
          <span class="sintro__line">One engineer<span class="sintro__stop">.</span></span>
        </h1>
        <p class="sintro__lede bs-lede">
          Websites for businesses that want more enquiries. Custom software for founders building a product and teams
          still running on spreadsheets. AI and automation in both, where they genuinely help.
        </p>
      </div>
    </section>

    <!-- The two services -->
    <section class="sroutes" aria-label="Our services">
      <div class="bs-wrap">
        <ol class="svc2">
          {
            services.map((s) => (
              <li class="svc2__item bs-grid">
                <div class="svc2__head">
                  <p class="bs-mono svc2__index">
                    <span>{s.index}</span> — Service
                  </p>
                  <h2 class="svc2__title bs-display">
                    <a href={s.href}>{s.title}</a>
                  </h2>
                  <p class="svc2__promise">{s.promise}</p>
                </div>
                <div class="svc2__body">
                  <p class="svc2__desc">{s.description}</p>
                  <ul class="svc2__links" aria-label={`${s.title}: sections`}>
                    {s.sections.map((sec) => (
                      <li>
                        <a href={sec.href}>
                          {sec.text} <span aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="bs-link svc2__cta" href={s.href}>
                    Explore {s.title.split(' &')[0].toLowerCase()} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="sroutes__note">
          <span class="bs-mono">Not sure which?</span>
          Tell us what you’re trying to achieve and we’ll recommend the right approach.
          <a href="/contact?type=project">Start a project <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>

    <ClosingCta bookingHref={bookingHref} index="03" />
  </div>

  <BasaltFooter slot="footer" links={footerLinks} services={footerServices} />
</Layout>

<style>
  /* One sentence per line */
  .sintro__line {
    display: block;
  }

  /* Intro */
  .sintro {
    padding-top: clamp(28px, 4.5vw, 56px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  .sintro__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
  }

  .sintro__title {
    margin-top: clamp(36px, 5vw, 72px);
    font-size: clamp(48px, 7vw, 108px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    font-weight: 800;
    font-stretch: 68%;
    max-width: 13ch;
  }

  .sintro__stop {
    color: var(--bs-signal);
  }

  .sintro__lede {
    margin-top: clamp(24px, 3vw, 36px);
  }

  /* The two services */
  .sroutes {
    position: relative;
    z-index: 1;
    background: var(--bs-ground);
    padding-bottom: clamp(72px, 10vw, 144px);
  }

  .svc2 {
    border-bottom: 1px solid var(--bs-rule);
  }

  .svc2__item {
    padding-block: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--bs-rule);
    row-gap: 28px;
    align-items: start;
  }

  .svc2__head,
  .svc2__body {
    grid-column: 1 / -1;
  }

  .svc2__index span {
    color: var(--bs-ink);
  }

  .svc2__title {
    margin-top: 14px;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 0.95;
  }

  .svc2__title a {
    color: var(--bs-ink);
    background-image: linear-gradient(var(--bs-signal), var(--bs-signal));
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.5s var(--bs-ease);
  }

  .svc2__title a:hover,
  .svc2__title a:focus-visible {
    background-size: 100% 2px;
  }

  .svc2__promise {
    margin-top: 16px;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.45;
    color: var(--bs-ink);
    max-width: 26em;
  }

  .svc2__desc {
    font-size: 16px;
    line-height: 1.6;
    max-width: 34em;
  }

  .svc2__links {
    margin-top: 20px;
    border-top: 1px solid var(--bs-rule);
  }

  .svc2__links li {
    border-bottom: 1px solid var(--bs-rule);
  }

  .svc2__links a {
    display: flex;
    justify-content: space-between;
    padding-block: 11px;
    font-size: 15px;
    color: var(--bs-ink);
    transition: color 0.2s var(--bs-ease);
  }

  .svc2__links a:hover {
    color: var(--bs-signal);
  }

  .svc2__cta {
    display: inline-block;
    margin-top: 24px;
  }

  .sroutes__note {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    font-size: 16px;
    line-height: 1.55;
  }

  .sroutes__note a {
    color: var(--bs-ink);
    text-decoration: underline;
    text-decoration-color: var(--bs-signal);
    text-underline-offset: 0.3em;
  }

  @media (min-width: 900px) {
    .svc2__head {
      grid-column: 1 / span 7;
    }

    .svc2__body {
      grid-column: 9 / -1;
      padding-top: 30px;
    }
  }
</style>
