---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import BlogListPage from '~/components/home/BlogListPage.astro';
import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description:
    'Practical writing from CausewaySoft on websites, software, accessibility and funding for businesses in Northern Ireland and beyond.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<BlogListPage
  metadata={metadata}
  label={`Blog${currentPage > 1 ? ` · Page ${currentPage}` : ''}`}
  title="Notes from the studio"
  lede="Practical writing on websites, software, accessibility and funding: what we’ve learned building for businesses in Northern Ireland and beyond."
  posts={page.data}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
/>
