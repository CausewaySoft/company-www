---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import UseCaseItem from '~/components/widgets/UseCaseItem.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';

const metadata = {
  title: "Chrome Extensions | Lightweight Productivity Tools",
  description: "Compact yet powerful browser extensions to boost productivity, engagement, and user experience.",
  // keywords: "chrome extensions, browser plugins, productivity tools, custom extensions, web enhancement"
};

// SEO Image Suggestions
// 	1.	Productivity Boosters — “Chrome extension menu with task shortcuts and automations”
// 	2.	Custom Integrations — “Browser plugin connected to CRM and task manager”
// 	3.	Data Capture Tools — “Chrome extension extracting and organizing web data”


---

<Layout metadata={metadata}>

  <!-- image source: https://unsplash.com/photos/a-laptop-computer-sitting-on-top-of-a-desk-oeS-ZzFqCaw -->
  <Hero2
    tagline="Small in size, mighty in impact"
    actions={[
      { variant: 'primary', text: 'Book a discovery session', href: 'https://calendly.com/causewaysoft/30min', icon: 'tabler:calendar', target: '_blank' },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1708447134618-bfb5d207ed95?q=80&w=2070&auto=format&fit=crop',
      alt: 'Custom software Development of the Chrome browser extension interface',
    }}
  >
    <Fragment slot="title">
      Chrome <span class="text-accent dark:text-white">Extensions</span>
    </Fragment>
    <Fragment slot="subtitle">
      We develop Chromium Extensions - Compact yet powerful tools that integrate seamlessly with browsers to enhance productivity and engagement.
    </Fragment>
  </Hero2>

  <Features
    tagline="Why users love our extensions"
    id="features"
    title="Designed for speed and simplicity"
    subtitle="No clutter, no lag — just the right functionality."
    columns={2}
    items={[
      { title: "Lightweight", description: "Minimal impact on browser performance.", icon: "tabler:feather" },
      { title: "Custom-built", description: "Tailored to your workflow or audience.", icon: "tabler:pencil" },
      { title: "Secure", description: "Privacy-first development practices.", icon: "tabler:shield-lock" },
      { title: "Cross-browser ready", description: "Extensions that work beyond Chrome.", icon: "tabler:device-desktop" },
    ]}
  />

  <!--
    image source: https://unsplash.com/photos/man-holding-cup-filled-with-coffee-on-table-TTPMpLl_2lc
   -->
  <UseCaseItem
    tagline='Productivity Boosters'
    title="Tools that save clicks"
    items={[
      { title: 'Description:', description: "Custom shortcuts, automations, and integrations directly in the browser." },
      { title: 'Benefits:', description: `Faster workflows, Easy adoption, Consistent results, Happier users` },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1467664631004-58beab1ece0d?q=80&w=2069&auto=format&fit=crop',
      alt: 'Browser extension for quick productivity shortcuts',
    }}
  />

  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Let us build a Chromium Extension for your Business"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: "Where shall our reply find you?"
      },
    ]},
    textarea={{
      label: 'Message',
      placeholder: "Tell us your challenges, dreams, or sparks"
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours.",
    button='Send Your Message'

    items={[
       {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading'
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        classes: {ctaLinks: 'emailLink'},
        href: 'enable javascript...',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        href: '+1 (234) 567-890',
        classes: {ctaLinks: 'phoneLink'},
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />


  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Discover the CausewaySoft blog"
    information={`Get the latest business and technology news, practical tutorials, and resources to help you digitally transform your business.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>