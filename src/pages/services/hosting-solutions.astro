---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import UseCaseItem from '~/components/widgets/UseCaseItem.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';

const metadata = {
  title: "EU & UK Hosting | Secure, Fast, Compliant",
  description: "Hosting in the EU, UK, and Northern Ireland — delivering speed, security, and compliance for your apps and sites.",
  // keywords: "EU hosting, UK hosting, secure hosting, GDPR hosting, fast hosting, enterprise hosting"
};

// SEO Image Suggestions
// 	1.	SMB Hosting — “Small business hosting servers in EU data center”
// 	2.	Enterprise Hosting — “High-security data center racks in UK facility”
// 	3.	Managed Hosting — “Engineer managing cloud hosting platform”


---

<Layout metadata={metadata}>


  <!-- image source: https://unsplash.com/photos/black-and-gray-electronic-device-uq5RMAZdZG4 -->
  <Hero2
    tagline="Your digital home, close to home"
    actions={[
      { variant: 'primary', text: 'Get hosting', href: '/#' },
      { text: 'See plans', href: '#features' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1489436969537-cf0c1dc69cba?q=80&w=1929&auto=format&fit=crop',
      alt: 'Data center servers in secure facility',
    }}
  >
    <Fragment slot="title">
      Hosting <span class="text-accent dark:text-white">Solutions</span>
    </Fragment>
    <Fragment slot="subtitle">
      Speed, security, and compliance — with servers based in the EU, UK, and Northern Ireland.
    </Fragment>
  </Hero2>

  <Features
    tagline="Why our hosting stands out"
    id="features"
    title="Fast, safe, and future-ready"
    subtitle="The right foundation for your digital presence."
    columns={2}
    items={[
      { title: "Local data centers", description: "Low latency and jurisdictional compliance.", icon: "tabler:map-pin" },
      { title: "Enterprise security", description: "Hardened infrastructure with 24/7 monitoring.", icon: "tabler:shield-lock" },
      { title: "Scalable resources", description: "From small sites to massive traffic loads.", icon: "tabler:arrows-diagonal" },
      { title: "Full management", description: "We handle backups, updates, and uptime.", icon: "tabler:server" },
    ]}
  />

  <!-- image source: https://unsplash.com/photos/photo-of-outer-space-Q1p7bh3SHj8 -->
  <UseCaseItem
    tagline='SMB Hosting'
    title="Simple plans for small businesses"
    items={[
      { title: 'Description:', description: "Fast, affordable hosting that just works." },
      { title: 'Benefits:', description: `Quick setup, Reliable uptime, GDPR-compliant, Great support` },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2070&auto=format&fit=crop',
      alt: 'Reliable hosting in Northern Ireland',
    }}
  />


  <ContactInline
    tagline="Contact Us"
    title="Let us take care of DevOps and Hosting Solutions for your Business"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: "The hero behind this message is…"
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: "Where shall our reply find you?"
      },
    ]},
    textarea={{
      label: 'Message',
      placeholder: "Tell us your challenges, dreams, or sparks"
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours.",
    button='Send Message'

    items={[
       {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading'
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        classes: {ctaLinks: 'emailLink'},
        href: 'enable javascript...',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        href: '+1 (234) 567-890',
        classes: {ctaLinks: 'phoneLink'},
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Stay informed with AstroWind's blog"
    information={`Explore our collection of articles, guides, and tutorials on web development, design trends, and using AstroWind effectively for your projects.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>