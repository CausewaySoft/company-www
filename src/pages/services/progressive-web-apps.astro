<!-- Features Widget - Our Edge -->
<Features
  tagline="Our Edge"
  id="features"
  title="We are your #1 PWA Development Agency"
  subtitle="We blend web innovation, mobile UX mastery, and business strategy — delivering apps that feel native, act global, and grow with you."
  columns={2}
  items={[
    {
      title: "Strategic-first design",
      description:
        "Every feature is built around your business goals, ensuring your PWA delivers real results.",
      icon:"tabler:target",
    },
    {
      title: "Performance obsessed",
      description:
        "PWAs optimised for speed, SEO, and engagement — measured, tested, and tuned.",
      icon:"tabler:clock",
    },
    {
      title: "AI-ready integrations",
      description:
        "From chatbots to recommendation engines, we can power your PWA with intelligent features.",
      icon:"tabler:cpu",
    },
    {
      title: "Future-proof code",
      description:
        "Built with modern frameworks and open web standards — ready for any device evolution.",
      icon:"tabler:shield-check",
    },
  ]}
/>

<!-- FAQs Widget ******************* -->
<FAQs
  tagline="FAQ"
  title="Questions we often hear"
  subtitle="Your clarity matters. Here are quick answers to the most common PWA questions."
  items={[
    {
      title: "Will my PWA work offline?",
      description: "Yes. We use service workers to cache critical resources so your app works without an internet connection.",
      icon:"tabler:cloud-off",
    },
    {
      title: "Can PWAs send push notifications?",
      description: "Absolutely — we set up browser push notifications so you can re-engage your audience.",
      icon:"tabler:bell",
    },
    {
      title: "Do PWAs go through app store approval?",
      description: "No. They’re distributed via the web but can be added to a user’s device like a native app.",
      icon:"tabler:download",
    },
    {
      title: "Are PWAs secure?",
      description: "Yes. All PWAs are served over HTTPS and follow strict security practices to protect user data.",
      icon:"tabler:lock",
    },
  ]}
>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</FAQs>


  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Let us build a Progressive Web App for your Business"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: "Where shall our reply find you?"
      },
    ]},
    textarea={{
      label: 'Message',
      placeholder: "Tell us your challenges, dreams, or sparks"
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours.",
    button='Send Your Message'

    items={[
       {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading'
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        classes: {ctaLinks: 'emailLink'},
        href: 'enable javascript...',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        href: '+1 (234) 567-890',
        classes: {ctaLinks: 'phoneLink'},
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />


  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Discover the CausewaySoft blog"
    information={`Get the latest business and technology news, practical tutorials, and resources to help you digitally transform your business.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>