// SEO-Rich Use Case Images & Alt Text Suggestions:
// 	1.	Modern responsive website homepage on desktop and mobile — “Responsive business website displayed on desktop and smartphone screens”
// 	2.	Website speed optimization dashboard — “Website performance metrics showing fast load times and SEO scores”
// 	3.	Creative agency homepage with bold visuals — “Creative agency homepage featuring modern design and engaging visuals”
---

<Layout metadata={metadata}>

    <Hero2
      tagline={heroSection.tagline}
      actions={[
        heroSection.ctaButtonPrimary,
        heroSection.ctaButtonSecondary,
      ]}
      image={heroSection.image}
    >
    <Fragment slot="title">
      {heroSection.title}
    </Fragment>

    <Fragment slot="subtitle">
      {heroSection.subtitle}
    </Fragment>
  </Hero2>

  <!--  Problem Statement -->
  <Content
    isReversed
    subtitle={problemStatement.subtitle}
    title={problemStatement.title}
    items={problemStatement.items}
    itemsTitle={problemStatement.itemsTitle}
    image={problemStatement.image}
  >
    <Fragment slot="content">
      <p>
        ...  then your website isn't doing its job.
        <br/>
        That's where we come in.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!--  Value Proposition -->
  <Content
    isReversed
    subtitle={valueProposition.subtitle}
    title={valueProposition.title}
    items={valueProposition.items}
    itemsTitle={valueProposition.itemsTitle}
    image={valueProposition.image}
  >
    <Fragment slot="content">
  
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Content>

    <!-- What we can do for your website -->
  <Features2
    title={productOfferings.title}
    subtitle={productOfferings.subtitle}
    columns={3}
    items={productOfferings.items}
  >
   <!-- <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment> -->

     <!-- 
    <Fragment slot="tagline">
      <p class="text-lg text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mt-0 mb-16">
        We're software engineers, not just website builders. When off-the-shelf solutions aren't enough, we can build exactly what your business needs.
      </p>
    </Fragment> -->
  </Features2>

  <p class="text-lg text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mt-0 mb-16">
    <strong>We're software engineers, not just website builders.</strong><br/>
    When off-the-shelf solutions aren't enough, we can build exactly what your business needs.
  </p>


  <!-- Websites built around your business -->
  <Features2
    title={productOfferings2.title}
    subtitle={productOfferings2.subtitle}
    columns={3}
    items={productOfferings2.items}
  />


  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Let us build a Website for your Business"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'Where shall our reply find you?',
      },
    ]}
    textarea={{
      label: 'Message',
      placeholder: 'Tell us your challenges, dreams, or sparks',
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours."
    button="Send Your Message"
    items={[
      {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading',
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        description: 'anti-spam protection, please enable javascript...',
        classes: { ctaLinks: 'emailLink' },
        href: '/',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        description: 'anti-spam protection, please enable javascript...',
        href: '/',
        classes: { ctaLinks: 'phoneLink' },
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <!-- BlogLatestPost Widget -->
  <BlogLatestPosts
    id="blog"
    title="Discover the CausewaySoft blog"
    information={`Get the latest business and technology news, practical tutorials, and resources to help you digitally transform your business.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

</Layout>
