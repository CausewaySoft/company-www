---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import UseCaseItem from '~/components/widgets/UseCaseItem.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

export const metadata = {
  title: "Websites | Custom, Responsive & High-Performance",
  description: "From landing pages to enterprise sites, we build responsive, lightning-fast websites that elevate your brand and convert visitors.",
  // keywords: "custom websites, responsive design, website development, SEO websites, high-performance web"
};

// SEO-Rich Use Case Images & Alt Text Suggestions:
// 	1.	Modern responsive website homepage on desktop and mobile — “Responsive business website displayed on desktop and smartphone screens”
// 	2.	Website speed optimization dashboard — “Website performance metrics showing fast load times and SEO scores”
// 	3.	Creative agency homepage with bold visuals — “Creative agency homepage featuring modern design and engaging visuals”


---

<Layout metadata={metadata}>

  <!-- Hero2 Widget 
    image source: https://unsplash.com/photos/person-using-macbook-air-on-brown-wooden-table-N8FHCBDSTco 
  ******************* -->

  <Hero2
    tagline="Websites that grow your brand"
    actions={[
      { variant: 'primary', text: 'Book a discovery call', href: '/#', icon:'tabler:rocket' },
      { text: 'Learn more', href: '#features' },
    ]}
    image={{
      //src: 'https://images.unsplash.com/photo-1625296276703-3fbc924f07b5?auto=format&fit=crop&w=2070&q=80',
      src: 'https://images.unsplash.com/photo-1586863981824-d9dd81824d6b?auto=format&fit=crop&w=2070&q=80',
      alt: 'Custom Website Development leads to better conversions and analytics.',
    }}
  >
    <Fragment slot="title">
        Custom <span class="text-accent dark:text-white"></span>Website</span> Design and Developement <br />
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        From sleek portfolios to high-converting business platforms — beautiful design, lightning speed, and strategic UX that turns visitors into lifelong customers.
    </Fragment>
  </Hero2>

  <!-- Features Widget *************** -->

  <Features
    tagline="Our Vision for Websites"
    id="features"
    title="Why choose our Website Design and Development Services"
    subtitle="We design and build websites that are visually striking, technically robust, and purpose-driven — from single-page portfolios to multi-page platforms with integrated booking and AI chat.",
    columns={2}
    items={[
        {
            title: "Design + Development",
            description:
            "Responsive design, accessible markup, and intuitive interfaces so your site looks great on every device.",
            icon: "tabler:brush",
        },
        {
            title: "Performance & SEO",
            description:
            "Optimised load times, semantic structure, and SEO best-practices to help you be found and fast to engage.",
            icon: "tabler:brush",
        },
        {
            title: "Conversion Tools",
            description:
            "AI chat agents, booking flows, lead capture — built to convert curious visitors into real customers.",
            icon: "tabler:message-circle",
        },
        {
            title: "Security & Reliability",
            description:
            "We build every website with modern technology stack with robust infrastructure, ensuring your site stays safe, stable, and online around the clock.",
            icon: "tabler:message-circle",
        },
        ]}
  />

   <Features
    tagline="Client Benefits"
    id="client-benefits"
    title="Website features turned into business outcomes"
    subtitle="We don’t sell features. We deliver outcomes: fast website that respect your brand and convert visitors into loyal customers.",
    columns={2}
    items={[
       {
            title: "Fast-loading pages",
            description:
            "so you can keep visitors engaged and reduce drop-off on every device. Extreme technical optimisation of the website serves as the SEO-friendly foundation.",
            icon:"tabler:bolt",
        },
        {
            title: "SEO-friendly foundation",
            description:
            "so you can get discovered by the right people and grow organic traffic over time.",
            icon:"tabler:search",
        },
        {
            title: "Conversion-focused UX",
            description:
            "so you can capture more leads, bookings, and sales without extra ad spend.",
            icon:"tabler:click",
        },
        {
            title: "Scalable architecture",
            description:
            "so you can add features — e-commerce, memberships, or bookings on your website; or any 3rd party integrations — when you're ready.",
            icon:"tabler:stack",
        },
    ]}
  />




  <!-- Content Widget **************** -->
  <Content
    tagline='Use Cases'
    title="Use cases"
    subtitle="Discover how AstroWind's versatile template serves as the ideal solution for various use cases, providing tailored solutions to drive success."
    isReversed >
  </Content>

<!-- UseCaseItem Widget 
   UCeCase for Small Business Sites

   img source: https://unsplash.com/photos/person-holding-black-smartphone-BJXAxQ1L7dI

  **************** -->
    <UseCaseItem
        tagline='Simple Websites for Local Business'
        title="Get found online and grow your calls"
        isReversed
        items={[
        {
            title: 'Description:',
            description: "For many local businesses — cleaners, tradespeople, builders, decorators — the hardest part isn’t doing the work, it's getting found. A beautifully designed, single-page site changes that overnight. We craft pages that are lightning-fast, mobile-friendly, and search-optimized so your business shows up when customers need you most. Add a clear call-to-action and a click-to-call button, and you've just turned your online presence into a steady stream of real enquiries.",
        },
        {
            title: 'Benefits:',
            description: `Mobile-friendly and lightning fast,
        Search engine optimized for local leads,
        Clear calls-to-action for instant engagement,
        Professional online presence within days`,
        },
        ]}
        image={{
        src: 'https://images.unsplash.com/photo-1548345680-f5475ea5df84?auto=format&fit=crop&w=1671&q=80',
        alt: 'Image a map with a pin pointing to local butcher business who is visible and foundable on the internet.',
        }}
    >
        <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <br />
        </h3>
        </Fragment>

        <Fragment slot="bg">
        <div class="absolute inset-0 bg-blue-50 dark:bg-transparent">"Get found online and grow your calls",</div>
        </Fragment>
    </UseCaseItem>


  <!-- UseCaseItem Widget 
   UCeCase for Startups

   image credit:
    https://unsplash.com/photos/macbook-pro-on-table-beside-white-imac-and-magic-mouse-hGV2TfOh0ns

  **************** -->
  <UseCaseItem
  tagline='Inspire visitors and win early adopters',
  title='Startup Website Curiosity Converters',
    isAfterContent={true}
    items={[
      {
        title: 'Description:',
        description: "For a startup, your website is often the very first handshake with the world — and first impressions matter. We design sites that blend clarity with intrigue, telling your story in a way that makes visitors lean in and want to know more. Clean, modern layouts. Bold headlines. Strategic calls-to-action. Every element is there to inspire trust, build excitement, and guide curious visitors toward becoming your first customers, backers, or partners.",
      },
      {
        title: 'Benefits:',
        description: `Modern, eye-catching design for brand impact,
      Messaging that builds trust and curiosity,
      Optimized for lead capture and conversion,
      Scalable structure ready for future growth`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?auto=format&fit=crop&w=1658&q=80',
      alt: 'Websites for small businesses are essential to conveying their branding and their success.',
    }}
  >
  </UseCaseItem>


<!-- UseCaseItem Widget 
   UCeCase for Small Business Sites

   image credit:
   https://unsplash.com/photos/person-holding-pencil-near-laptop-computer-5fNmWej4tAA

  **************** -->
    <UseCaseItem
        tagline='SME Digital Growth Platforms'
        title="Websites that work as hard as you do"
        isReversed
        items={[
        {
            title: 'Description:',
            description: "For SMEs, your website isn't just a brochure — it's a living part of your business. Whether you're a consultancy, retailer, manufacturer, or service provider, your site needs to convert interest into action. We design custom solutions with features like integrated booking systems, client portals, AI chat assistants, and performance analytics — all tailored to your workflow. The result? A website that's not just online, but actively working to win you business every day.",
        },
        {
            title: 'Benefits:',
            description: `Custom features matched to your workflow,
                Integrated booking, portals, and automation,
                AI-powered chat assistants for instant support,
                Analytics to track and improve performance`,
        },
        ]}
        image={{
        src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1671&q=80',
        alt: 'For a SME, a website not only established authority but can also automate their business processes.',
        }}
    >
        <Fragment slot="content">
        <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <br />
        </h3>
        </Fragment>

        <Fragment slot="bg">
        <div class="absolute inset-0 bg-blue-50 dark:bg-transparent">"Get found online and grow your calls",</div>
        </Fragment>
    </UseCaseItem>



    <!-- Steps Widget ****************** -->

  <Steps
    id="our-process"
    tagline= "Project Steps",
    title="Our Website Design and Development Process"
    subtitle="A calm, clear process that keeps you informed, involved, and excited at every milestone.",
    items={[
      {
        title: 'Step 1: <span class="font-medium">Discovery</span>',
        description: "We listen. Goals, customers, and brand essence — so the site reflects what makes you unique.",
        icon: 'tabler:telescope',
      },
      {
        title: 'Step 2: <span class="font-medium">Strategy & Wireframes</span>',
        description: "Structure and journeys mapped out so every page has a purpose and a path to conversion.",
        icon: 'tabler:layout',
      },
      {
        title: 'Step 3: <span class="font-medium">Design & Build</span>',
        description: "Pixel-perfect design brought to life with fast, maintainable code and accessibility in mind.",
        icon: 'tabler:code',
      },
      {
        title: 'Step 4: <span class="font-medium">Launch & Measure</span>',
        description: "Go live with tracking, performance checks, and a plan to iterate for growth.",
        icon: 'tabler:rocket',
      },
      {
        title: 'Step 5: <span class="font-medium">Support & Growth</span>',
        description: "From content updates to new features and AI tuning — we stay partners in your growth.",
        icon: 'tabler:message-chatbot',
      },
      {
        title: 'Achieve and Succeed!',
        icon: 'tabler:trophy',
        classes: {
          icon: 'text-amber-600 dark:text-amber-600',
          title: 'text-amber-600 dark:text-amber-600'
        }
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1692106979244-a2ac98253f6b??q=70&w=690&auto=format&fit=crop',
      alt: 'Image of a MacBook laptop with Visual Studio Code opened, presenting moder software engineering tools being used.',
    }}
  />

  

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Words from real customers"
    testimonials={[
      {
        title: 'Simple Business Website for a local Cleaning Business',
        testimonial: "I came to CausewaySoft, with a simple goal in mind, to show up online. I needed a simple and cost effective website for my cleaning business. They built me a beautiful website, and did initial marketing of it. Overtime, I noticed more customers telling me they found me online! It's made a massive difference to my confidence as a business owner and helped me elevate the quality of business that I get.",
        name: "Betty's Cleaning",
        job: 'Local Cleaning Agency | Coleraine Area',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Emily Kennedy Image',
        },
      },
      {
        title: 'Corporate Client – Custom Login Screen with CMS',
        testimonial: "We needed a polished, branded login page with the ability to easily update hero images and links. CausewaySoft delivered a solution that looked amazing and was incredibly simple for our team to manage. They understood our vision, nailed the design, and made the process smooth from start to finish.",
        name: 'Martin ....',
        job: 'IT Project Manager | Expro',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Sarah Hansen Image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'More testimonials...',
      href: 'https://github.com/onwidget/astrowind',
      icon: 'tabler:chevron-right',
    }}
  />


     <Features
    tagline="Our Edge"
    id="features"
    title="We are your #1 Website Design and Development Agency"
    subtitle="We combine latest web-development technology, and your business strategy. The result is a site that not only looks magical — it works, measures, and grows.",
    columns={2}
    items={[
        {
            title: "Strategic-first design",
            description:
            "We start with your goals — not trendy templates. Every layout and CTA is designed to move customers forward.",
            icon:"tabler:target",
        },
        {
            title: "Performance obsessed",
            description:
            "Pages that load fast and rank better—so visitors stay, engage, and convert. We benchmark and optimise for results.",
            icon:"tabler:clock",
        },
        {
            title: "AI-powered conversion",
            description:
            "Optional AI chat agents and automated flows that capture leads and book meetings while you focus on what matters.",
            icon:"tabler:cpu",
        },
        {
            title: "Proven process & proof",
            description:
            "Years of experience, real client outcomes, and a transparent workflow from kickoff to launch.",
            icon:"tabler:shield-check",
        },
    ]}
  />





  <!-- Pricing Widget ******************* -->
