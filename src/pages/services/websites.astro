---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import UseCaseItem from '~/components/widgets/UseCaseItem.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Steps from '~/components/widgets/Steps.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';

export const metadata = {
  title: 'Websites | Custom, Responsive & High-Performance',
  description:
    'From landing pages to enterprise sites, we build responsive, lightning-fast websites that elevate your brand and convert visitors.',
  // keywords: "custom websites, responsive design, website development, SEO websites, high-performance web"
};

const heroSection = {
  tagline: 'WEBSITES BUILT TO CONVERT',
  title: 'Your website should win you business.',
  subtitle: `We build fast, persuasive websites that turn visitors into enquiries, bookings and customers. \n
  If your website is slow, outdated, difficult to use or simply isn’t bringing in enough business, we’ll find out why and fix it.`,
  ctaButtonPrimary: {
    variant: 'primary' as const,
    target: '_blank' as const,
    text: 'Get a Free Website Check',
    href: '/free-website-check',
  },
  ctaButtonSecondary: {
    variant: 'secondary' as const,
    // text: 'View Renovation Projects',
    text: 'See Our Work',
    href: '#scroll',
  },
  image: {
    src: 'https://images.unsplash.com/photo-1586863981824-d9dd81824d6b?auto=format&fit=crop&w=2070&q=80',
    alt: 'A man sitting in a coffee shop using a laptop, showcasing a clean and professional website dashboard.',
  },
};

// SEO-Rich Use Case Images & Alt Text Suggestions:
// 	1.	Modern responsive website homepage on desktop and mobile — “Responsive business website displayed on desktop and smartphone screens”
// 	2.	Website speed optimization dashboard — “Website performance metrics showing fast load times and SEO scores”
// 	3.	Creative agency homepage with bold visuals — “Creative agency homepage featuring modern design and engaging visuals”
---

<Layout metadata={metadata}>

    <Hero2
      tagline={heroSection.tagline}
      actions={[
        heroSection.ctaButtonPrimary,
        heroSection.ctaButtonSecondary,
      ]}
      image={heroSection.image}
    >
    <Fragment slot="title">
      {heroSection.title}
    </Fragment>

    <Fragment slot="subtitle">
      {heroSection.subtitle}
    </Fragment>
  </Hero2>


  

  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Let us build a Website for your Business"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'Where shall our reply find you?',
      },
    ]}
    textarea={{
      label: 'Message',
      placeholder: 'Tell us your challenges, dreams, or sparks',
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours."
    button="Send Your Message"
    items={[
      {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading',
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        description: 'anti-spam protection, please enable javascript...',
        classes: { ctaLinks: 'emailLink' },
        href: '/',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        description: 'anti-spam protection, please enable javascript...',
        href: '/',
        classes: { ctaLinks: 'phoneLink' },
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Discover the CausewaySoft blog"
    information={`Get the latest business and technology news, practical tutorials, and resources to help you digitally transform your business.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
