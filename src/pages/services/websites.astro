---
/**
 * Websites service page: Basalt redesign.
 * Art direction: docs/design-review-claude-opus5.5.md (section 5)
 * Images are placeholders until real photography is in place.
 */
import Layout from '~/layouts/PageLayout.astro';

import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/components/home/basalt.css';

import Image from '~/components/common/Image.astro';
import BasaltHeader from '~/components/home/BasaltHeader.astro';
import BasaltFooter from '~/components/home/BasaltFooter.astro';
import SectionHead from '~/components/home/SectionHead.astro';
import SelfAudit from '~/components/home/SelfAudit.astro';
import WorkIndex from '~/components/home/WorkIndex.astro';
import ColumnSteps from '~/components/home/ColumnSteps.astro';
import ClosingCta from '~/components/home/ClosingCta.astro';
import FaqList from '~/components/home/FaqList.astro';
import OfferRows from '~/components/home/OfferRows.astro';
import { bookingHref, reviewCallHref, innerNavItems, footerLinks, serviceLinks } from '~/components/home/nav';

import portfolioImg_Renovations from '~/assets/images/portfolio/causewayrenovations-website-laptop-iphone.png';

export const metadata = {
  title: 'Websites | Custom, Responsive & High-Performance',
  description:
    'Fast, persuasive websites that turn visitors into enquiries, bookings and customers. Built, fixed and extended by an independent studio in Belfast, Northern Ireland.',
};

const projectHref = '/contact?type=project&service=website';

// Placeholder photo (to be replaced with our own photography)
const heroImage = {
  src: 'https://images.unsplash.com/photo-1586863981824-d9dd81824d6b?auto=format&fit=crop&w=2070&q=80',
  alt: 'Someone working on a laptop in a café',
};

const symptoms = [
  'takes too long to load',
  'looks poor on mobile',
  'doesn’t explain what you actually do',
  'hides your phone number or enquiry form',
  'makes customers work to find what they need',
  'looks like it hasn’t been updated in years',
  'gets visitors but very few enquiries',
];

const outcomes = [
  {
    title: 'Get found',
    description:
      'A technically strong, SEO-friendly foundation helps search engines understand your business and helps the right customers find you.',
  },
  {
    title: 'Get attention',
    description:
      'Clear messaging and modern design communicate what you offer quickly, build trust and give visitors a reason to stay.',
  },
  {
    title: 'Get enquiries',
    description:
      'Every important page has a purpose and a clear next step: calling you, requesting a quote, booking an appointment or buying something.',
  },
  {
    title: 'Stay fast',
    description: 'We obsess over performance, so your website loads quickly on phones, desktops and slower connections.',
  },
  {
    title: 'Keep growing',
    description:
      'Need booking, payments, portals, automation or AI later? A proper technical foundation means your website never becomes a dead end.',
  },
];

const offers = [
  {
    key: 'Fix',
    title: 'Fix an existing website',
    description:
      'Already have a website? You don’t necessarily need a new one. We find what’s holding it back and improve the parts that matter most.',
    deliverables: ['Performance', 'Mobile UX', 'SEO', 'Conversion', 'Accessibility'],
    price: 'Starts with a free review call',
    cta: { text: 'Book a free review call', href: reviewCallHref, external: true },
  },
  {
    key: 'Build',
    title: 'Build a new website',
    description:
      'Starting from scratch? A fast, modern website built around your customers, your brand and your goals. No bloated templates, no unnecessary complexity.',
    deliverables: ['Strategy', 'Copy', 'Design', 'Development', 'SEO', 'Analytics'],
    price: 'From £2,000',
    cta: { text: 'Start a website project', href: projectHref },
    featured: true,
  },
  {
    key: 'Extend',
    title: 'Make your website a business tool',
    description:
      'Need your website to do more? We build the functionality behind it, from booking and payments to client portals, AI assistants and integrations.',
    deliverables: ['Booking', 'Payments', 'Lead capture', 'Portals', 'AI', 'Automation'],
    price: 'Quoted individually',
    cta: { text: 'Discuss your requirements', href: projectHref },
  },
];

const projects = [
  {
    title: 'Causeway Renovations',
    kind: 'Business website',
    description: 'A modern website for a house renovation company, with AI-powered business interactions.',
    outcome: 'Website built for AI-agent interactions.',
    tags: ['Business website', 'Lead generation', 'AI-agentic'],
    href: 'https://causewayrenovations.co.uk',
    linkLabel: 'Visit the site',
    image: {
      src: portfolioImg_Renovations,
      alt: 'The Causeway Renovations website on an iPhone and a MacBook',
    },
  },
];

// The three kinds of website (sections with anchors, see the restructure plan).
// Business websites absorbs the old "Who it's for" audiences.
const kinds = [
  {
    id: 'business-websites',
    title: 'Business websites',
    audience: 'Local businesses, startups, growing companies',
    description:
      'Websites that explain what you do, build trust fast and make getting in touch effortless. For local firms turning searches into calls, startups making a new idea clear, and growing businesses that have outgrown their first site.',
    examples: ['Local SEO', 'Click-to-call', 'Quote & booking forms', 'Reviews', 'Analytics'],
    proof: { text: 'See Causeway Renovations', href: '#work' },
  },
  {
    id: 'ecommerce',
    title: 'E-commerce',
    audience: 'Businesses selling online',
    description:
      'Online selling that fits how you actually sell: a carefully presented catalogue, bookings and deposits, or products that need a quote rather than just a basket. Secure payments and order handling that connect to the tools you already use.',
    examples: ['Product catalogues', 'Secure payments', 'Bookings & deposits', 'Order emails', 'Integrations'],
  },
  {
    id: 'ai',
    title: 'AI-enhanced websites',
    audience: 'Any website',
    description:
      'Websites that AI assistants can read, understand and recommend, plus practical AI where it helps visitors: answering common questions, qualifying enquiries and getting leads to you faster.',
    examples: ['AI-readable structure', 'Enquiry assistants', 'Lead qualification', 'Automatic follow-ups'],
    proof: { text: 'Causeway Renovations is built for AI agents', href: '#work' },
  },
];

const steps = [
  {
    title: 'Find the opportunity',
    description: 'We learn about your business, customers and goals, and find where your website can do more.',
  },
  {
    title: 'Plan the experience',
    description: 'We structure the pages, messaging and customer journeys around those goals.',
  },
  {
    title: 'Design & build',
    description: 'You get a polished, responsive website backed by fast, maintainable code.',
  },
  {
    title: 'Launch & measure',
    description: 'We test performance, accessibility, SEO foundations and conversion paths before going live.',
  },
  {
    title: 'Improve',
    description: 'Once it’s working, we keep optimising, adding functionality and helping it grow with your business.',
  },
];

const reasons = [
  {
    title: 'Design that has a job to do',
    description:
      'We don’t design pages simply because they look nice. Every section should help a visitor understand, trust or act.',
  },
  {
    title: 'Performance without compromises',
    description:
      'Fast websites are better for users, search engines and conversions. Performance is part of the product, not something to fix after launch.',
  },
  {
    title: 'Engineering behind the design',
    description:
      'Not a pretty frontend held together with plugins and workarounds: proper, maintainable software that can grow when your requirements do.',
  },
  {
    title: 'One person who sees the whole picture',
    description:
      'No translating your requirements between a designer, a developer, an SEO agency and an automation specialist. We handle the whole thing.',
  },
];

const faqs = [
  {
    q: 'How much does a website cost?',
    a: 'It depends on what you’re trying to achieve. Straightforward business websites start from £2,000, while more involved websites and custom functionality are quoted individually. We’ll tell you what we recommend and why before any work begins.',
  },
  {
    q: 'How long does it take?',
    a: 'A straightforward business website can typically be completed in 2–4 weeks. Larger websites and projects involving custom functionality take longer. You’ll have a clear timeline before we start.',
  },
  {
    q: 'Can you improve my existing website instead of rebuilding it?',
    a: 'Yes. In many cases, improving an existing website is the better option. We’ll look at what’s working, what’s not, and whether a rebuild is actually justified.',
  },
  {
    q: 'Will you guarantee Google rankings?',
    a: 'No honest developer can guarantee a specific Google ranking. We build a technically strong SEO foundation, improve your site’s structure and performance, and make your content easier for search engines to understand.',
  },
  {
    q: 'Can you write the website content?',
    a: 'Yes. We can help with messaging and copy, so you don’t spend three weeks staring at a blank document wondering what to write on your About page.',
  },
  {
    q: 'What happens after launch?',
    a: 'You can manage things yourself, ask us to handle updates, or keep working with us as your website evolves.',
  },
];

---

<Layout metadata={metadata}>
  <BasaltHeader slot="header" items={innerNavItems} cta={{ text: 'Contact', href: '/contact' }} bookingHref={bookingHref} />

  <div class="bs">
    <!-- Hero -->
    <section class="whero" aria-labelledby="websites-title">
      <div class="bs-wrap">
        <div class="whero__meta bs-mono">
          <p>Websites · Built to convert</p>
          <p>Belfast, Northern Ireland</p>
        </div>
        <div class="whero__grid bs-grid">
          <div class="whero__text">
            <h1 id="websites-title" class="whero__title bs-display">
              Your website should win you business<span class="whero__stop">.</span>
            </h1>
            <p class="whero__lede bs-lede">
              We build fast, persuasive websites that turn visitors into enquiries, bookings and customers. If yours is
              slow, outdated, hard to use or simply not bringing in enough business, we’ll find out why and fix it.
            </p>
            <div class="whero__actions">
              <a class="bs-btn" href={projectHref}>Start a website project <span class="bs-arrow" aria-hidden="true">→</span></a>
              <a class="bs-link" href="#work">See a recent website</a>
            </div>
          </div>
          <figure class="whero__figure">
            <Image
              src={heroImage.src}
              alt={heroImage.alt}
              layout="fullWidth"
              widths={[400, 640, 900]}
              sizes="(min-width: 900px) 40vw, 100vw"
              loading="eager"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- 01 Diagnosis -->
    <section class="bs-section" id="diagnosis" aria-labelledby="diagnosis-title">
      <div class="bs-wrap">
        <SectionHead
          id="diagnosis-title"
          index="01"
          label="The diagnosis"
          title="Is your website doing its job?"
          lede="It’s your business card, your shop window and your sales tool, and often the first thing a potential customer sees."
        />
        <div class="section-body">
          <SelfAudit intro="If your website…" items={symptoms} reviewHref={reviewCallHref} projectHref={projectHref} />
        </div>
      </div>
    </section>

    <!-- 02 Outcomes -->
    <section class="bs-section" id="outcomes" aria-labelledby="outcomes-title">
      <div class="bs-wrap">
        <SectionHead
          id="outcomes-title"
          index="02"
          label="What a good website does"
          title="We turn underperforming websites into business assets."
          lede="Strategic design, conversion-focused UX and serious technical performance: websites that do more than look good."
        />
        <ol class="rows section-body">
          {
            outcomes.map((o, i) => (
              <li class="row bs-grid" data-reveal>
                <span class="row__num bs-mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="row__title bs-display">{o.title}</h3>
                <p class="row__desc">{o.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 03 What we build -->
    <section class="bs-section" id="what-we-build" aria-labelledby="kinds-title">
      <div class="bs-wrap">
        <SectionHead
          id="kinds-title"
          index="03"
          label="What we build"
          title="Three kinds of website, each built to do a job."
          lede="Whether you’re a local business, a startup or a growing company, we build around what your website needs to achieve."
        />
        <div class="section-body">
          <OfferRows items={kinds} />
        </div>
      </div>
    </section>

    <!-- 04 Offers -->
    <section class="bs-section" id="offers" aria-labelledby="offers-title">
      <div class="bs-wrap">
        <SectionHead
          id="offers-title"
          index="04"
          label="Three ways in"
          title="What we can do for your website."
          lede="Improve what you have, build something new, or make it do more."
        />
        <ol class="offers section-body">
          {
            offers.map((o, i) => (
              <li class:list={['offer', { 'offer--featured': o.featured }]} data-reveal>
                <p class="bs-mono offer__label">
                  <span class="offer__num">{String(i + 1).padStart(2, '0')}</span> — {o.key}
                </p>
                <h3 class="offer__title bs-display">{o.title}</h3>
                <p class="offer__desc">{o.description}</p>
                <p class="offer__tags bs-mono">{o.deliverables.join(' · ')}</p>
                <p class="offer__price">{o.price}</p>
                <a
                  class:list={[o.featured ? 'bs-btn' : 'bs-link', 'offer__cta']}
                  href={o.cta.href}
                  {...(o.cta.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {o.cta.text} <span class="bs-arrow" aria-hidden="true">{o.cta.external ? '↗' : '→'}</span>
                  {o.cta.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
        </ol>
        <div class="statement" data-reveal>
          <p class="statement__line bs-display">We’re software engineers, not just website builders.</p>
          <p class="statement__sub">When off-the-shelf solutions aren’t enough, we build exactly what your business needs.</p>
        </div>
      </div>
    </section>

    <!-- 05 Proof -->
    <WorkIndex
      projects={projects}
      index="05"
      label="Recent website"
      title="Built for a real business."
      lede="A renovation company’s website, designed to bring in enquiries and ready for AI agents to use."
    />

    <!-- 06 Process -->
    <ColumnSteps
      steps={steps}
      index="06"
      label="How we work"
      title="From “just a website” to a system that brings in business."
      lede="Every project starts with one question: what should this website actually achieve? Then we work backwards."
    />

    <!-- 07 Why us -->
    <section class="bs-section" id="why" aria-labelledby="why-title">
      <div class="bs-wrap">
        <SectionHead id="why-title" index="07" label="Why build with us" title="Design with a job. Engineering behind it." />
        <ul class="quad section-body">
          {
            reasons.map((r, i) => (
              <li class="quad__item" data-reveal>
                <span class="bs-mono quad__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="quad__title bs-display">{r.title}</h3>
                <p class="quad__desc">{r.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 08 FAQs -->
    <section class="bs-section" id="faq" aria-labelledby="faq-title">
      <div class="bs-wrap">
        <SectionHead
          id="faq-title"
          index="08"
          label="Questions"
          title="The things people ask first."
          lede="Price, timing and what happens after launch. Anything else, just ask."
        />
        <div class="section-body">
          <FaqList items={faqs} />
        </div>
      </div>
    </section>

    <ClosingCta bookingHref={bookingHref} index="09" projectHref={projectHref} />
  </div>

  <BasaltFooter slot="footer" links={footerLinks} services={serviceLinks} />
</Layout>

<style>
  .section-body {
    margin-top: clamp(48px, 7vw, 96px);
  }

  /* Hero */
  .whero {
    padding-top: clamp(28px, 4.5vw, 56px);
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  .whero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
  }

  .whero__grid {
    margin-top: clamp(36px, 5vw, 72px);
    row-gap: 48px;
    align-items: end;
  }

  .whero__text,
  .whero__figure {
    grid-column: 1 / -1;
  }

  .whero__title {
    font-size: clamp(52px, 7.4vw, 112px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    font-weight: 800;
    font-stretch: 68%;
  }

  .whero__stop {
    color: var(--bs-signal);
  }

  .whero__lede {
    margin-top: clamp(24px, 3vw, 36px);
  }

  .whero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .whero__figure :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    clip-path: polygon(0 5%, 100% 0, 100% 100%, 0 100%);
  }

  /* Outcome rows (same rhythm as the home services list, without links) */
  .rows {
    border-bottom: 1px solid var(--bs-rule);
  }

  .row {
    padding-block: clamp(22px, 2.6vw, 34px);
    border-top: 1px solid var(--bs-rule);
    row-gap: 10px;
    align-items: baseline;
  }

  .row__num {
    grid-column: 1 / span 2;
  }

  .row__title {
    grid-column: 3 / -1;
    font-size: clamp(34px, 4.4vw, 64px);
  }

  .row__desc {
    grid-column: 3 / -1;
    font-size: 16px;
    line-height: 1.55;
    max-width: 32em;
  }

  /* Offers: three tall columns */
  .offers {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--bs-rule);
  }

  .offer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 0 36px;
    border-bottom: 1px solid var(--bs-rule);
  }

  .offer--featured::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 3px;
    background: var(--bs-signal);
  }

  .offer__num {
    color: var(--bs-ink);
  }

  .offer__title {
    font-size: clamp(30px, 2.8vw, 42px);
    line-height: 1;
  }

  .offer__desc {
    font-size: 16px;
    line-height: 1.6;
    max-width: 34em;
  }

  .offer__tags {
    color: var(--bs-text);
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 13px;
  }

  .offer__price {
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--bs-font-display);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 24px;
    color: var(--bs-ink);
  }

  /* Same height for button and text links, so the prices line up */
  .offer__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 46px;
  }

  .statement {
    margin-top: clamp(64px, 8vw, 120px);
  }

  .statement__line {
    font-size: clamp(40px, 5.6vw, 84px);
    max-width: 16ch;
  }

  .statement__sub {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.55;
    max-width: 34em;
  }

  /* Why us */
  .quad {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--bs-rule);
  }

  .quad__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 16px;
    row-gap: 8px;
    align-content: start;
    padding-block: 26px 30px;
    border-bottom: 1px solid var(--bs-rule);
  }

  .quad__num {
    grid-row: 1 / span 2;
    color: var(--bs-ink);
    padding-top: 6px;
  }

  .quad__title {
    font-size: clamp(26px, 2.2vw, 32px);
    line-height: 1.02;
  }

  .quad__desc {
    font-size: 16px;
    line-height: 1.6;
    max-width: 34em;
  }

  @media (min-width: 900px) {
    .whero__text {
      grid-column: 1 / span 7;
    }

    .whero__figure {
      grid-column: 9 / -1;
    }

    .row__num {
      grid-column: 1 / span 1;
    }

    .row__title {
      grid-column: 2 / span 6;
    }

    .row__desc {
      grid-column: 9 / -1;
    }

    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(16px, 2vw, 32px);
      border-bottom: 1px solid var(--bs-rule);
    }

    .offer {
      border-bottom: 0;
      padding-bottom: 32px;
    }

    .quad {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(16px, 2vw, 32px);
    }
  }
</style>
