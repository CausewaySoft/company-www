---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import UseCaseItem from '~/components/widgets/UseCaseItem.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';

const metadata = {
  title: "UI/UX Design & Strategy | Intuitive, Impactful Interfaces",
  description: "We craft intuitive interfaces and seamless journeys — turning casual users into loyal advocates.",
  // keywords: "UI design, UX strategy, user interface design, product design, user experience, design systems"
};

// SEO Image Suggestions
// 	1.	SaaS Dashboards — “Minimalist dashboard UI for complex enterprise data”
// 	2.	Mobile App UI — “Clean mobile app interface with intuitive navigation”
// 	3.	E-commerce UX — “Product page designed for fast conversion”


---

<Layout metadata={metadata}>

  <!-- 
    image source: https://unsplash.com/photos/yellow-click-pen-on-white-printer-paper-gcHFXsdcmJE
  -->
  <Hero2
    tagline="Design that moves hearts and minds"
    actions={[
      { variant: 'primary', text: 'Start your design journey', href: '/#' },
      { text: 'See our work', href: '#features' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?q=80&w=2070&auto=format&fit=crop',
      alt: 'UI/UX design sketches and digital mockups',
    }}
  >
    <Fragment slot="title">
      UI/UX <span class="text-accent dark:text-white">Design & Strategy</span>
    </Fragment>
    <Fragment slot="subtitle">
      Interfaces that feel natural, journeys that feel effortless, and designs that leave an impression.
    </Fragment>
  </Hero2>

  <!-- image source: https://unsplash.com/photos/wall-mounted-helvetica-alphabet-poster-above-sofa-iXHdGk8JVYU -->
  <Features
    tagline="Why design matters"
    id="features"
    title="More than just good looks"
    subtitle="We design for emotion, clarity, and conversion."
    columns={2}
    items={[
      { title: "Human-centered", description: "Built around your users' real needs.", icon: "tabler:users" },
      { title: "Conversion-focused", description: "Designs that guide and persuade.", icon: "tabler:chart-line" },
      { title: "Consistent systems", description: "UI kits and patterns that scale with you.", icon: "tabler:layers-linked" },
      { title: "Cross-platform ready", description: "Flawless experiences on web and mobile.", icon: "tabler:device-mobile" },
    ]}
  />

  <UseCaseItem
    tagline='SaaS Dashboards'
    title="Clarity for complex data"
    items={[
      { title: 'Description:', description: "Data-heavy platforms simplified with clear layouts and visual hierarchy." },
      { title: 'Benefits:', description: `Faster decisions, Happier users, Lower learning curve, Stronger retention` },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1543487945-139a97f387d5?q=80&w=2070&auto=format&fit=crop',
      alt: 'Clean and intuitive SaaS dashboard UI',
    }}
  />


  <ContactInline
    tagline="Contact Us"
    title="Let us take care of UI/UX strategy for your Business"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: "The hero behind this message is…"
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: "Where shall our reply find you?"
      },
    ]},
    textarea={{
      label: 'Message',
      placeholder: "Tell us your challenges, dreams, or sparks"
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours.",
    button='Send Message'

    items={[
       {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading'
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        classes: {ctaLinks: 'emailLink'},
        href: 'enable javascript...',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        href: '+1 (234) 567-890',
        classes: {ctaLinks: 'phoneLink'},
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />


  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Stay informed with AstroWind's blog"
    information={`Explore our collection of articles, guides, and tutorials on web development, design trends, and using AstroWind effectively for your projects.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>