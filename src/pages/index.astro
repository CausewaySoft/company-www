    },
  ],
  image: {
      src: 'https://images.unsplash.com/photo-1517070277245-d8e0a45c2495?q=80&w=690&auto=format&fit=crop',
    alt: 'CausewaySoft - Why CausewaySoft?',
  },
};

// section 6
export const founderSection = {
  tagline: 'Meet the person behind CausewaySoft',
  title: 'Mateusz Krawczyk',
  subtitle:
    'Founder & Principal Software Engineer. I started CausewaySoft to help ambitious businesses build better digital products without the layers, overhead and unnecessary complexity of a traditional agency. With 7+ years of experience building web applications and digital products, I work directly with clients from the initial idea through design, development and launch. Based in Northern Ireland. Working with clients internationally.',
  contentTitle: '',
  contentItems: [
    {
      title: '7+ years',
      description: 'Software engineering experience',
    },
    {
      title: 'Full-stack',
      description: 'Complete solution development from concept to launch',
    },
    {
      title: 'Direct',
      description: 'You work with the person building it.',
    },
  ],
  image: {
    src: 'https://images.pexels.com/photos/29204802/pexels-photo-29204802.jpeg?auto=compress&cs=tinysrgb&w=1600&lazy=load',
    alt: '',
  },
};

// section 7
export const callToAction = {
  tagline: 'From Spark to Stone',
  title: 'Build piece by piece. Create something bigger.',
  subtitle:
    "The Giant's Causeway wasn't built from one enormous piece of stone. It was formed piece by piece, with each part fitting together to create something much bigger. We take the same approach to software.",
  contentTitle: 'Start with the idea. Build the foundations. Add what matters. Keep improving.',
  contentItems: [
    {
      title:
        'The result should be more than a collection of features. It should be a product that helps your business move forward.',
    },
  ],
  image: {
    src: '',
    alt: '',
  },
