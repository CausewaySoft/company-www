---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/HeroFullWidth.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'CausewaySoft - Web-Apps and Mobile Apps Developement Agency in Belfast, Northern Ireland ',
  ignoreTitleTemplate: true,
};

const heroSection = {
  tagline: 'Giant Apps for Giant Visionaries',
  title: 'We build digital products that move businesses forward.',
  subtitle:
    'High-performance websites, web applications, AI solutions and custom software, built around your business and its goals.',
  ctaButtonPrimary: {
    variant: 'primary' as const,
    target: '_blank' as const,
    text: 'Start a Project',
    href: '/contact',
    icon: 'tabler:rocket',
  },
  ctaButtonSecondary: {
    variant: 'secondary' as const,
    text: 'Explore Our Services',
    href: '/services',
  },
  image: {
    src: '~/assets/images/giants-causeway-causewaysoft-herobg.png',
    alt: 'Hand-drawn illustration of the Giant’s Causeway',
  },
};

export const problemStatement = {
  tagline: 'Have an idea worth building?',
  title: 'From new ideas to better ways of working.',
  subtitle:
    'We help you identify the right solution, then design and build software that solves real business problems.',
  itemsTitle: 'What can we help you achieve?',
  items: [
    {
      title: 'Launch a new product',
      description:
        'Turn your idea into a focused digital product, starting with what matters most.',
    },
    {
      title: 'Improve your website or software',
      description:
        'Modernise outdated digital experiences to better serve your customers and business.',
    },
    {
      title: 'Automate repetitive work',
      description:
        'Connect your tools and streamline manual processes so your team can focus on what matters.',
    },
  ],
