  title: 'What we build',
  subtitle: '',
  items: [
    {
      title: 'Websites',
      description:
        'Fast, modern websites designed to make your business look credible, get found and turn visitors into enquiries, bookings and customers.',
      icon: 'tabler:world-www',
      callToAction: {
        variant: 'link',
        text: 'Explore Website Development',
        href: '/services/websites',
        icon: 'tabler:arrow-right',
      },
    },
    {
      title: 'Web Applications',
      description:
        'Custom platforms, portals and business applications built around the way your business actually works.',
      icon: 'tabler:app-window',
      callToAction: {
        variant: 'link',
        text: 'Explore Web Applications',
        href: '/services/web-applications',
        icon: 'tabler:arrow-right',
      },
    },
    {
      title: 'AI-Powered Solutions',
      description:
        'Practical AI tools that automate work, improve customer experiences and help your team get more done.',
      icon: 'tabler:brain',
      callToAction: {
        variant: 'link',
        text: 'Explore AI Solutions',
        href: '/services/ai-agents-solutions',
        icon: 'tabler:arrow-right',
      },
    },
    {
      title: 'Custom Software',
      description: "When off-the-shelf software doesn't fit, we build the software that does.",
      icon: 'tabler:code',
      callToAction: {
        variant: 'link',
        text: 'Explore Custom Software',
        href: '/services/custom-software',
        icon: 'tabler:arrow-right',
      },
    },
  ],
};

export const projectSteps = {
  title: 'From idea to working product',
  subtitle:
    'You might already have a detailed specification. You might only have a problem that needs solving. Either is fine. We can help you work out what to build, define the right solution, design the experience and turn it into a reliable product.',
  items: [
    {
      title: 'Step 1 — Discover',
      description: 'Understand the business, the problem and what success looks like.',
      icon: 'tabler:search',
    },
    {
      title: 'Step 2 — Define',
      description: 'Turn ideas and requirements into a clear, practical product plan.',
      icon: 'tabler:clipboard-list',
    },
    {
      title: 'Step 3 — Design',
      description: 'Create an intuitive experience before writing thousands of lines of code.',
      icon: 'tabler:palette',
    },
    {
      title: 'Step 4 — Build',
      description: 'Engineer the product using modern, maintainable technology.',
      icon: 'tabler:code',
    },
    {
      title: 'Step 5 — Launch & Grow',
      description: 'Get it into the hands of real users, measure what happens and keep improving it.',
      icon: 'tabler:rocket',
    },
  ],
  image: {
    src: 'https://images.unsplash.com/photo-1505576457712-b769c0c0a354?q=70&w=690&auto=format&fit=crop',
    alt: 'Our App Development Process',
  },
};

// section 4,
export const productOfferings3 = {
  title: 'Built for ambitious businesses',
  subtitle: '',
  items: [
    {
      title: 'Startups',
      description: 'Move from idea to MVP without building a mountain of unnecessary software.',
      icon: 'tabler:rocket',
    },
    {
      title: 'Small Businesses',
      description:
        'Replace outdated websites, manual processes and disconnected tools with software that actually helps the business.',
      icon: 'tabler:building',
    },
    {
      title: 'Growing Companies',
      description: 'Build the platforms, integrations and automation you need as the business becomes more complex.',
      icon: 'tabler:chart-line',
    },
  ],
};

// section 5
export const productOfferings4 = {
  title: 'Why CausewaySoft?',
  subtitle:
    'Small enough to care. Technical enough to build properly. CausewaySoft is an independent software engineering studio. You work directly with the person designing and building your product.',
  items: [
    {
      title: 'Business first',
      description:
        "Technology is only useful when it solves a real problem. We start with what you're trying to achieve, not which framework happens to be fashionable this week.",
      icon: 'tabler:target',
    },
    {
      title: 'Direct collaboration',
      description:
        'No layers of account managers and hand-offs. You work directly with the engineer responsible for your project.',
      icon: 'tabler:users',
    },
    {
      title: 'Modern engineering',
      description:
        'React, TypeScript, Node.js, Astro, AI and other modern technologies are tools, not trophies. We choose what fits the problem.',
      icon: 'tabler:code',
    },
    {
      title: 'Built to evolve',
      description:
        "Your first version shouldn't become your biggest technical headache. We build with the next stage of your business in mind.",
      icon: 'tabler:code',
    },
    {
      title: 'Quality by default',
      description:
        "Fast, accessible, secure and maintainable are not premium add-ons. They're part of building software properly.",
