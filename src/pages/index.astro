  title: 'From idea to working product',
  subtitle:
    'You might already have a detailed specification. You might only have a problem that needs solving. Either is fine. We work with you to define the right solution, design the experience and turn it into a reliable product.',
  items: [
    {
      title: 'Step 1 — Discover',
      description: 'Understand the business, the problem and what success looks like.',
      icon: 'tabler:search',
    },
    {
      title: 'Step 2 — Define',
      description: 'Turn ideas and requirements into a clear, practical product plan.',
      icon: 'tabler:clipboard-list',
    },
    {
      title: 'Step 3 — Design',
      description: 'Create an intuitive experience before writing thousands of lines of code.',
      icon: 'tabler:palette',
    },
    {
      title: 'Step 4 — Build',
      description: 'Engineer the product using modern, maintainable technology.',
      icon: 'tabler:code',
    },
    {
      title: 'Step 5 — Launch & Grow',
      description: 'Get it into the hands of real users, measure what happens and keep improving it.',
      icon: 'tabler:rocket',
      // classes: {
      //   icon: 'text-amber-600 dark:text-amber-600',
      //   title: 'text-amber-600 dark:text-amber-600',
      // },
    },
  ],
  image: {
    src: 'https://images.unsplash.com/photo-1505576457712-b769c0c0a354?q=70&w=690&auto=format&fit=crop',
    alt: 'Our App Development Process',
  },
};

