      callToAction: {
        variant: 'link',
        text: 'Explore AI Solutions',
        href: '/services/ai-agents-solutions',
        icon: 'tabler:arrow-right',
      },
    },
    {
      title: 'Custom Software',
      description:
        'When existing tools fall short, get software designed around the way your business actually works.',
      icon: 'tabler:code',
      callToAction: {
        variant: 'link',
        text: 'Explore Custom Software',
