// Section 7 — Final call to action
export const callToAction = {
  tagline: 'From Spark to Stone',
  title: 'Start with an idea. Build something lasting.',
  subtitle:
    'Great products are built piece by piece. We help you lay the right foundations, focus on what matters and create something your business can build on.',
  contentTitle: 'Have an idea? Let’s work out how to make it happen.',
  contentItems: [
    {
      title:
        'Tell me what you want to achieve. We’ll explore the problem, identify the right approach and map out the next steps.',
