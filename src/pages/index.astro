---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/HeroFullWidth.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';

const metadata = {
  title: 'CausewaySoft - Web-Apps and Mobile Apps Developement Agency in Belfast, Northern Ireland ',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Contact Us ',
        href: '/#contact',
        target: '_blank',
        icon: 'tabler:rocket',
      },
      { text: 'Learn more', href: '#services' },
    ]}
    image={{ src: '~/assets/images/giants-causeway-causewaysoft-herobg.png', alt: 'CausewaySoft Hero Image - Pencil hand drawn Giants Causeway' }} 
  >
    <!-- 
      image={{ src: '~/assets/images/openart-try7.png', alt: 'CausewaySoft Hero Image - Pencil hand drawn Giants Causeway' }}
      image={{ src: '~/assets/images/giants-causeway-causewaysoft-herobg.png', alt: 'CausewaySoft Hero Image - Pencil hand drawn Giants Causeway' }} 
    -->
    <Fragment slot="title">
      <span class="text-accent">Giant</span> Apps for
      Giant<span class="text-accent"> Visionaries</span> 
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        At <span class="font-semibold">CausewaySoft</span>, we are not just web developers. We are digital blacksmiths. Builders of dreams. Partners to pioneers. From bold startups to scaling companies, we help visionaries like you shape tomorrow’s web.
      </span>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note icon="tabler:bulb" title="Philosophy:" description="Launch faster. Grow stronger. Build legendary." />

  <!-- Features Widget *************** -->

  <Features
    id="services"
    tagline="What We Do"
    title="Your Idea Deserves More Than Just Code.<br/>It Deserves a Legacy."
    subtitle="At CausewaySoft, we transform ambitious ideas into powerful digital products — driven by clean code, scalable design, and relentless creativity. We build with the same spirit that raised the basalt columns of the North: purpose, passion, and permanence."
    items={[
      {
        title: 'Websites',
        description:
          'Beautiful, fast, and optimized sites that don’t just look good — they convert, engage, and inspire.',
        icon: 'tabler:world-www'
      },
      {
        title: 'Web Applications',
        description:
          'From MVP to full-scale platforms, we engineer dynamic, high-performance apps built to scale.',
        icon: 'tabler:app-window'
      },
      {
        title: 'Progressive Web Apps (PWAs)',
        description:
          'Fast, offline-ready, app-like experiences with web reach.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Hybrid Mobile Apps',
        description:
          'Built once, deployed everywhere. Using React Native and other leading stacks.',
        icon: 'tabler:device-mobile-star',
      },
      {
        title: 'Chrome Extensions',
        description:
          'Lightweight, focused tools that supercharge productivity and user engagement.',
        icon: 'tabler:brand-chrome',
      },
      {
        title: 'AI-Powered Solutions',
        description:
          'We infuse AI into your apps to make them smarter, faster, and more intuitive — from chatbots to intelligent automation.',
        icon: 'tabler:ai',
      }
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    id="about-us"
    tagline="About Us"
    title="Why CausewaySoft?"
    subtitle="Our studio is rooted in Northern Ireland, where the sea meets ancient stone - a place of legends, resilience, and transformation.<br/>Like the Giant's Causeway itself, we stand for bold structure, enduring quality, and awe-inspiring results."
    items={[
      {
        title: 'Startup-First Mindset',
        description:
          'We speak your language. We move fast. We get it done.',
        icon:'tabler:flame'
      },
      {
        title: 'End-to-End Craftsmanship',
        description:
          'From idea to launch, we’re with you every step of the way.',
        icon:'tabler:hammer'
      },
      {
        title: 'Global Reach, Local Grit',
        description:
          'Serving clients across the world with the spirit of the North behind us.',
        icon:'tabler:world-heart'
      },
      {
        title: 'Modern Tech Stack',
        description:
          'React, Next.js, Astro, Node.js, Tailwind, JavaScript, TypeScript, .NET & beyond.',
        icon:'tabler:code'
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1517070277245-d8e0a45c2495?q=80&w=690&auto=format&fit=crop',
      alt: 'Giants Causeway',
      class: 'grayscale hover:grayscale-0 rounded shadow-lg'
    }}
  >
  <!-- Image sources:
    https://unsplash.com/@ebommart
    https://unsplash.com/photos/rock-formations-near-body-of-water-BDwQ7xG6SEc
    https://unsplash.com/photos/rock-formation-on-body-of-water-eRB0avrALdY
   -->
    <Fragment slot="content">This isn’t just development. It’s <span class="font-bold">foundational work</span> for companies that dare to build differently.</Fragment>

  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="our-process"
    tagline="Our Process"
    title="From Spark to Stone.<br/>From Idea to Impact."
    subtitle="Every great product starts as a bold idea — but it’s the process that shapes it into something lasting. At CausewaySoft, we’ve refined a battle-tested journey that transforms vision into reality. Whether you’re launching an MVP or scaling a platform, we guide you through each step with clarity, creativity, and craftsmanship."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Discovery</span>',
        description:
          "We begin at the source: your vision. Through deep discovery calls, we listen, question, and uncover the heart of your idea — goals, users, and pain points. No tech talk yet. Just understanding your mission, your market, and what success looks like.",
        icon: 'tabler:telescope',
      },
      {
        title: 'Step 2: <span class="font-medium">Design</span>',
        description:
          "This is where ideas take shape. We craft UI/UX designs that are beautiful, intuitive, and conversion-focused — tailored for your audience and guided by modern design systems. We bring your product to life before writing a single line of code.",
        icon: 'tabler:paint',
      },
      {
        title: 'Step 3: <span class="font-medium">Develop</span>',
        description:
          'Now the real forging begins. Our engineers build fast, scalable, and secure applications using modern technologies like React, Next.js, Astro, Node.js, React Native, and more. Whether it’s a custom website, PWA, mobile app, or AI-powered tool — we write clean code that lasts.',
        icon: 'tabler:code',
      },
      {
        title: 'Step 4: <span class="font-medium">Deploy</span>',
        description:
          'Launch day is just the beginning. We handle testing, infrastructure, and deployment with care — so your product goes live smoothly, confidently, and ready for scale. Cloud-ready, user-tested, performance-tuned.',
        icon: 'tabler:cloud-computing',
      },
      {
        title: 'Step 5: <span class="font-medium">Support & Scale</span>',
        description:
          'We don’t just walk away. We monitor, maintain, improve, and iterate. From post-launch support to new features, scaling infrastructure, or adding AI — we stay by your side as your product grows, adapts, and levels up.',
        icon: 'tabler:message-chatbot',
      },
      {
        title: 'Achieve and Succeed!',
        icon: 'tabler:trophy',
        classes: {
          icon: 'text-amber-600 dark:text-amber-600',
          title: 'text-amber-600 dark:text-amber-600'
        }
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1505576457712-b769c0c0a354?q=70&w=690&auto=format&fit=crop',
      alt: 'Our App Development Process',
      class: ''
    }}
  />
  <!-- Image source: https://unsplash.com/@batjko -->

  <!-- HighlightedPosts Widget ******* -->

<!-- 
  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  />
 -->

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into how we build the apps."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What kind of businesses do you work with?',
        description:
          "We partner with ambitious startups, scale-ups, and small to medium-sized companies across the globe. Whether you’re launching your first MVP or reinventing an existing product, we help you turn bold ideas into powerful digital solutions — fast, scalable, and future-ready.",
      },
      {
        title: 'How much does it cost to build a custom web or mobile app?',
        description:
          'Every project is different. Costs depend on complexity, features, and timeline. We offer flexible pricing models — from fixed-scope packages to agile sprints. Whether it’s a simple web app or a feature-rich progressive or hybrid mobile app, we tailor solutions to fit your goals and budget.',
      },
      {
        title: 'Do you build AI-powered features into apps and websites?',
        description:
          "Yes. We can integrate AI into your custom software — from chatbots and smart recommendations to automation tools and data-driven insights. AI isn’t just a trend — it’s a strategic edge, and we’ll help you use it wisely.",
      },
      {
        title: "What technologies do you use?",
        description:
          "We specialize in modern, battle-tested tech stacks like .NET, PHP Laravel, React, Next.js, Astro, Node.js, React Native, Tailwind CSS, Firebase and more. Our team picks the right tools to match your vision — ensuring performance, security, and long-term maintainability.",
      },
      {
        title: 'Can you build a website or app if I only have an idea?',
        description:
          "Absolutely. We work with many non-technical founders. From idea validation and prototyping to design, development, and launch — we guide you every step of the way. You bring the vision. We’ll bring it to life.",
      },
      {
        title: 'Do you offer ongoing support and updates after launch?',
        description:
          "Yes. We don’t just build and vanish. We offer ongoing support, maintenance, performance monitoring, and feature updates — so your product stays secure, modern, and competitive. Whether it’s fixing bugs, scaling infrastructure, or adding AI-driven functionality down the line, we’ve got your back.",
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->


<!--
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Schedule a Discovery Call',
        href: '',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      🚀 Launch Your Legend
    </Fragment>

    <Fragment slot="subtitle">
      Whether you’re building a unicorn or laying the first stone — we believe in your vision. We’re here to bring it to life with passion, power, and precision.
      <br/>
      Let’s build something <span class="font-bold">remarkable<span/> together.
    </Fragment>
  </CallToAction>
  -->

<!--
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Your Journey',
        href: '',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      🌊 Let’s Build Something Enduring
    </Fragment>

    <Fragment slot="subtitle">
      No shortcuts. No generic templates. Just bold ideas, solid code, and a process built on trust, grit, and creativity.
    </Fragment>
  </CallToAction>
-->

  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Drop us a message today!"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: "Where shall our reply find you?"
      },
    ]},
    textarea={{
      label: 'Message',
      placeholder: "Tell us your challenges, dreams, or sparks"
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours.",
    button='Send Message'

    items={[
       {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading'
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        classes: {ctaLinks: 'emailLink'},
        href: 'enable javascript...',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        href: '+1 (234) 567-890',
        classes: {ctaLinks: 'phoneLink'},
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />
  
</Layout>
