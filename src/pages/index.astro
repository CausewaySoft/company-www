---

<Layout metadata={metadata}>
  <Hero
    tagline={heroSection.tagline}
    actions={[heroSection.ctaButtonPrimary, heroSection.ctaButtonSecondary]}
    image={heroSection.image}
  >
    <Fragment slot="title">
      {heroSection.title}
    </Fragment>

    <Fragment slot="subtitle">
      {heroSection.subtitle}
    </Fragment>
  </Hero>

  <!-- Brand Statement -->
  <Note title="Launch faster. Grow stronger. Build legendary." />

  <!--
    Problem Statement \
    Have an idea worth building?
  -->
  <Content
    id="scroll"
    isReversed
    title={problemStatement.tagline}
    subtitle={problemStatement.title}
    items={problemStatement.items}
    itemsTitle={problemStatement.itemsTitle}
    image={problemStatement.image}
  >
    <Fragment slot="content">
      <!-- <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        {problemStatement.contentTitle}
      </h3>
      <p>{problemStatement.subtitle}</p> -->
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!--
    WHAT WE BUILD.
  -->
  <Features2
    id="services"
    columns={4}
    title={productOfferings2.title}
    subtitle={productOfferings2.subtitle}
    items={productOfferings2.items}
  />

  <!--
    OUR PROCESS
  -->
  <Steps
    id="our-process"
    title={projectSteps.title}
    subtitle={projectSteps.subtitle}
    items={projectSteps.items}
    image={projectSteps.image}
  />

  <!-- Features Widget 
    ***************
    Who is it for Section.
  -->
  <Features
    id="services"
    columns={3}
    title={productOfferings3.title}
    subtitle={productOfferings3.subtitle}
    items={productOfferings3.items}
  />

  <!--  Value Proposition -->
  <Content
    isReversed
    id="about"
    subtitle={productOfferings4.subtitle}
    title={productOfferings4.title}
    items={productOfferings4.items}
    image={productOfferings4.image}
  >
    <Fragment slot="content">
      <!-- {productOfferings4.contentTitle && (
        <h3 class="font-bold tracking-tight dark:text-white sm:text-2xl">
          {productOfferings4.contentTitle}
        </h3>
      )} -->
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!--
    Meet the Founder Section.
  -->
  <Features2
    id="services2"
    tagline={founderSection.tagline}
    title={founderSection.title}
    subtitle={founderSection.subtitle}
    items={founderSection.contentItems}
    image={founderSection.image}
    bodyText={founderSection.bodyText}
    columns={3}
    classes={{
      container: 'max-w-5xl',
      items: {
        // panel: ""
      },
    }}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Your Project',
        href: '',
        target: '_blank',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title"> 🌊 Let's Build Something Enduring </Fragment>

    <Fragment slot="subtitle">
      Bold ideas, solid code, and a process built on trust, grit, and
      creativity.
    </Fragment>
  </CallToAction>

