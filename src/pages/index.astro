    {
      title: 'Startups',
      description: 'Move from idea to MVP without building a mountain of unnecessary software.',
      icon: 'tabler:rocket',
    },
    {
      title: 'Small Businesses',
      description:
        'Replace outdated websites, manual processes and disconnected tools with software that actually helps the business.',
      icon: 'tabler:building',
    },
    {
      title: 'Growing Companies',
      description: 'Build the platforms, integrations and automation you need as the business becomes more complex.',
      icon: 'tabler:chart-line',
