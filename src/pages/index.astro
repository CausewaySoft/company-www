    },
    {
      title: 'Step 3 — Design',
      description:
        'Shape the user experience and validate the approach before development begins.',
      icon: 'tabler:palette',
    },
    {
      title: 'Step 4 — Build',
      description:
        'Develop and test your product with a focus on quality, performance and maintainability.',
      icon: 'tabler:code',
    },
    {
      title: 'Step 5 — Launch & Improve',
      description:
        'Launch your product, learn from real-world use and improve it as your needs evolve.',
      icon: 'tabler:rocket',
      // classes: {
      //   icon: 'text-amber-600 dark:text-amber-600',
      //   title: 'text-amber-600 dark:text-amber-600',
      // },
