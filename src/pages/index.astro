  contentTitle:
    'CausewaySoft is an independent software engineering studio, based in Northern Ireland, working internationally.',
  items: [
    {
      title: 'Business first',
      description: 'We start with the problem and desired outcome, then work backwards to the technology.',
      icon: 'tabler:target',
