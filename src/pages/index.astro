export const productOfferings4 = {
  title: 'Why CausewaySoft?',
  subtitle: 'Senior engineering. Direct collaboration. No unnecessary layers.',
  contentTitle:
    'An independent software engineering studio based in Northern Ireland, working with clients internationally.',
  items: [
    {
      title: 'Business-first thinking',
      description:
        'We start with your goals and challenges, then choose the right solution.',
      icon: 'tabler:target',
