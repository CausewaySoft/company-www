    {
      title: 'Direct collaboration',
      description: 'You work directly with the engineer responsible for your project.',
      icon: 'tabler:users',
    },
    {
      title: 'Modern engineering',
      description: 'We use modern technologies where they make sense, without chasing trends for the sake of it.',
      icon: 'tabler:code',
