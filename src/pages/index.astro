---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/HeroFullWidth.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import ContactInline from '~/components/widgets/ContactInline.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'CausewaySoft - Web-Apps and Mobile Apps Developement Agency in Belfast, Northern Ireland ',
  ignoreTitleTemplate: true,
};

const heroSection = {
  tagline: 'Giant Apps for Giant Visionaries',
  title: 'We build digital products that move businesses forward.',
  subtitle: `High-performance websites, web applications, AI solutions and custom software for businesses that need more than an off-the-shelf solution.`,
  ctaButtonPrimary: {
    variant: 'primary' as const,
    target: '_blank' as const,
    text: 'Start a Project',
    href: '/#',
    icon: 'tabler:rocket',
  },
  ctaButtonSecondary: {
    variant: 'secondary' as const,
    // text: 'View Renovation Projects',
    text: 'Explore Our Services',
    href: '#',
  },
  image: {
    src: '~/assets/images/giants-causeway-causewaysoft-herobg.png',
    alt: 'CausewaySoft Hero Image - Pencil hand drawn Giants Causeway',
  },
};

export const problemStatement = {
  tagline: 'Have an idea worth building?',
  title:
    "Whether you're launching something new, improving an existing business or replacing a painful manual process, we combine product thinking, design and engineering to turn ideas into working products.",
  subtitle: 'you',
  itemsTitle: 'We help you work out what to build, then build it properly.',
  items: [
    {
      title: 'Launch something new',
      description: 'Turn an idea into a focused digital product without building unnecessary complexity.',
    },
    {
      title: 'Improve what already exists',
      description:
        'Upgrade an outdated website, application or digital experience around what your business actually needs.',
    },
    {
      title: 'Replace manual work',
      description:
        'Automate repetitive processes and connect disconnected tools with software that works for your team.',
    },
  ],
  image: {
    src: 'https://images.unsplash.com/photo-1517070277245-d8e0a45c2495?q=80&w=690&auto=format&fit=crop',
    alt: '',
  },
};

