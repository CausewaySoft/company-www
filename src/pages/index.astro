---

<Layout metadata={metadata}>
  <Hero
    tagline={heroSection.tagline}
    actions={[heroSection.ctaButtonPrimary, heroSection.ctaButtonSecondary]}
    image={heroSection.image}
  >
    <Fragment slot="title">
      {heroSection.title}
    </Fragment>

    <Fragment slot="subtitle">
      {heroSection.subtitle}
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->
  <Note icon="tabler:bulb" title="Philosophy:" description="Launch faster. Grow stronger. Build legendary." />

  <!--
    Problem Statement \
    Have an idea worth building?
  -->
  <Content
    id="scroll"
    isReversed
    title={problemStatement.tagline}
    subtitle={problemStatement.title}
    items={problemStatement.items}
    itemsTitle={problemStatement.itemsTitle}
    image={problemStatement.image}
  >
    <Fragment slot="content">
      <!-- <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        {problemStatement.contentTitle}
      </h3>
      <p>{problemStatement.subtitle}</p> -->
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!--
    WHAT WE BUILD.
  -->
  <Features2
    id="services"
    columns={4}
    title={productOfferings2.title}
    subtitle={productOfferings2.subtitle}
    items={productOfferings2.items}
  />

  <!--
    OUR PROCESS
  -->
  <Steps
    id="our-process"
    title={projectSteps.title}
    subtitle={projectSteps.subtitle}
    items={projectSteps.items}
    image={projectSteps.image}
  />


  <!-- Features Widget 
    ***************
    Who is it for Section.
  -->
  <Features
    id="services"
    columns={3}
    title={productOfferings3.title}
    subtitle={productOfferings3.subtitle}
    items={productOfferings3.items}
  />

  <!--  Value Proposition -->
  <Content
    isReversed
    subtitle={productOfferings4.subtitle}
    title={productOfferings4.title}
    items={productOfferings4.items}
    image={productOfferings4.image}
  >
    <Fragment slot="content">
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Content>


    <!-- Features Widget 
    ***************
    Meet the Founder Section.
  -->
  <Content
    id="services2"
    title={founderSection.title}
    subtitle={founderSection.subtitle}
    items={founderSection.contentItems}
    image={founderSection.image}
  />

<CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Your Journey',
        href: '',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      🌊 Let’s Build Something Enduring
    </Fragment>

    <Fragment slot="subtitle">
      No shortcuts. No generic templates. Just bold ideas, solid code, and a process built on trust, grit, and creativity.
    </Fragment>
  </CallToAction>


<CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Your Journey',
        href: '',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      {callToAction.title}
    </Fragment>

    <Fragment slot="subtitle">
      {callToAction.subtitle}
    </Fragment>
  </CallToAction>

  <ContactInline
    id="contact"
    tagline="Contact Us"
    title="Drop us a message today!"
    subtitle="Send us an email or Book a FREE Discovery Call to begin your journey."
    formInputs={[
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'Where shall our reply find you?',
      },
    ]}
    textarea={{
      label: 'Message',
      placeholder: 'Tell us your challenges, dreams, or sparks',
    }}
    description="By submitting this form, you agree to our privacy policy and consent to us using your information to respond to your inquiry. We typically reply within 24 business hours."
    button="Send Your Message"
    items={[
      {
        description: 'Book a Discovery Call',
        classes: {
          container: 'd-flex content-center	',
          ctaLinks: '!text-current mb-2 text-xl font-semibold font-heading',
        },
        href: 'https://calendly.com/causewaysoft',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      {
        title: 'Email us',
        description: 'anti-spam protection, please enable javascript...',
        classes: { ctaLinks: 'emailLink' },
        href: '/',
        icon: 'tabler:mail',
      },
      {
        title: 'Call us',
        description: 'anti-spam protection, please enable javascript...',
        href: '/',
        classes: { ctaLinks: 'phoneLink' },
        icon: 'tabler:headset',
      },
      {
        title: 'Follow us',
        description: '@causewaysoft',
        href: 'https://www.linkedin.com/company/causewaysoft',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />
</Layout>
