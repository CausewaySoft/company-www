---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import FeatureList from '~/components/widgets/FeatureCardsSimple.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Solutions for Healthcare | CausewaySoft',
  description: 'Transform your healthcare practice with our tailored digital solutions. Enhance patient care, streamline operations, and improve outcomes with CausewaySoft.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- HERO -->
  <Hero
    tagline="Solutions for healthcare"
    actions={[
      { variant: 'primary', text: 'Book Your Free Consultation', href: 'https://calendly.com/causewaysoft' },
      { text: 'Try a Demo', href: '/contact' },
    ]}
    image={{ src: '~/assets/images/hero-team-dashboard.jpg', alt: 'Professional team using dashboards' }}
  >
    <Fragment slot="title">
      Transform Your Medical Practice with Smart Digital Systems
    </Fragment>

    <Fragment slot="subtitle">
      <strong>Automate admin. Improve patient experience. Grow your clinic.</strong>
      <br/>
      DTFF funding may cover up to 70% of your digital transformation project.
    </Fragment>
  </Hero>

  <!-- QUICK NOTE / CTA 
    title="Deadline: < 2 weeks left! "
   
  -->
  
  <Note
    description="Eligible for up to <b>£20,000</b> in DTFF funding. Empower your healthcare teams with secure, enterprise-grade AI tools designed to enhance productivity and patient care."
  />

  <!-- 
    subtitle='Empower your healthcare teams with secure, enterprise-grade AI tools designed to enhance productivity and patient care.'
  -->
  <!-- PROBLEM STATEMENT -->
  <Content
    tagline="Challenge"
    title="Your Clinic is Running on Too Many Disconnected Tools…"
  >
    <Fragment slot="content">
      <p>Booking systems, spreadsheets, CRMs… your team spends more time managing tools than patients.</p>
      <p>We build a single, intelligent system to manage patients, admin, and data — all in one place.</p>
    </Fragment>
  </Content>

  <!-- WHAT YOU'LL GAIN -->
  <Features
    title="What You’ll Gain"
    items={[
      {
        title: 'Streamlined Operations',
        description: 'Replace disconnected apps and paperwork with a single system that connects appointments, patient communications, billing, reporting, CRM and follow-ups.',
        icon: 'tabler:stack-2'
      },
      {
        title: 'Automation & AI',
        description: 'Automate reminders, post-visit messages, AI-powered triage/chat tools, and lead tracking for private consultations.',
        icon: 'tabler:robot'
      },
      {
        title: 'Data You Can Trust',
        description: 'All your key numbers — patient volume, revenue, and no-shows — in one live dashboard. No more exporting CSVs.',
        icon: 'tabler:gauge'
      },
    ]}
  />

  <!-- SOLUTION / DIGITAL OPERATIONS HUB (DETAILED FEATURES) -->
  <Features
    title="Meet the Digital Operations Hub"
    items={[
      { title: 'Patient Management', description: 'Seamless appointments, reminders, and follow-ups.', icon: 'tabler:calendar-check' },
      { title: 'Automation', description: 'AI-powered workflows for repetitive admin.', icon: 'tabler:automatic-gearbox' },
      { title: 'Analytics', description: 'Real-time dashboards for insights and growth.', icon: 'tabler:chart-line' },
      { title: 'Compliance', description: 'Secure, GDPR-compliant systems and processes.', icon: 'tabler:shield-check' },
    ]}
  />


  <!-- Features2 Widget ************** -->
  <Features2
  columns={4}
    title="Security & Compliance You Can Trust"
    items={[
      {
        title: 'We never train on your documents or patient data',
        icon: 'tabler:file-text-shield',
      },
      {
        title: 'Your confidential information remains private and protected',
        icon: 'tabler:lock-password',
      },
      {
        title: 'Data encryption at rest and in transit',
        icon: 'tabler:cloud-lock',
      },
      {
        title: 'Multi-factor authentication keeps your account secure',
        icon: 'tabler:key',
      },
    ]}
  />

  <!-- EXAMPLE MINI-CASE -->
  <!-- <Content
    isReversed
    tagline="Example"
    title="Real impact — example outcome"
    items={[
      { title: 'Accounting firm outcome', description: 'Reduced manual invoice processing by 40% — more time for advisory work.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&w=1200&q=60',
      alt: 'Accounting dashboard example',
    }}
  /> -->

  <!-- BENEFITS / OUTCOMES (STATS & CALLS) -->
  <Stats
    stats={[
      { title: 'of users saved at least 2 hours/week', amount: '88%' },
      { title: 'saw productivity gains', amount: '92%' },
      { title: 'experienced greater innovation and creativity', amount: '75%' },
    ]}
  />

  <!-- TESTIMONIAL -->
  <Content
    tagline="Testimonial"
    title="What our clients say"
  >
    <Fragment slot="content">
      <blockquote>“The new system transformed how we manage patients — our team spends more time caring and less time chasing data.” — Dr. A, Private GP</blockquote>
    </Fragment>
  </Content>


  <!-- MINI CASE -->
  <!-- <Content
    isAfterContent
    tagline="Mini-case"
    title="Mini-case: Accounting firm"
    items={[
      { title: 'Result', description: 'A 15-person accounting firm reduced invoice processing by 40% and secured £18,500 in DTFF funding.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1554224154-22dec7ec8818?auto=format&fit=crop&w=1200&q=60',
      alt: 'Team celebrating results',
    }}
  /> -->


  <!-- HOW IT WORKS (STEPS) -->
  <Steps
    title="How It Works: 4 Simple Steps"
    items={[
      { title: 'Discovery Session', description: 'Map workflows & identify automation opportunities.', icon: 'tabler:search' },
      { title: 'System Design', description: 'Select the right tools & integrations for your clinic.', icon: 'tabler:layout' },
      { title: 'Build & Integrate', description: 'Connect systems and create a unified portal/dashboard.', icon: 'tabler:plug-connected' },
      { title: 'Training & Handover', description: 'Empower your team to manage the new system confidently.', icon: 'tabler:school' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=60',
      alt: 'Process steps illustration',
    }}
  />



  <!-- FUND YOUR TRANSFORMATION -->
  <Content
    tagline="Funding"
    title="Fund Your Transformation with DTFF"
  >
    <Fragment slot="content">
      <p>Up to <strong>£20,000</strong> available to help modernize your clinic.</p>
      <p>We guide you through the funding process and ensure your project qualifies.</p>
    </Fragment>
  </Content>


   <!-- WHAT IS DTFF -->
  <Content
    id="what-is-dtff"
    tagline="What is the DTFF?"
    title="How to use the Digital Transformation Flexible Fund (DTFF) for your Medical Practice?"
    video={{
      id: 'TBNTAH6w_9Q'
    }}
    >
    <Fragment slot="content">
      <p>
        The <strong>DTFF grant</strong> gives Northern Ireland micro and small businesses up to <strong>£20,000</strong> to invest in technology and software that accelerates growth and efficiency.
      </p>

      <ul class="list-disc list-inside mt-4 space-y-2">
        <li>Covers up to <strong>70%</strong> of project costs</li>
        <li>Eligible for <strong>Micro</strong> and <strong>Small</strong> (1-49 FTEs) Northern Irish businesses trading for <strong>12+ months</strong>, and who are <strong>VAT registered</strong></li>
        <li></li>
      </ul>

      <p class="mt-4">
        The £20K grant supports digital transformation of your practice using modern technologies such as <em>AI, workflow automation, analytics dashboards, blockchain</em>, which is exactly the technologies we took to create the Digital Operations Hub powering your practice.
      </p>
      <p class="mt-4">
        <strong>Why this matters:</strong> Most small medical practices still struggle with manual processes and legacy systems. DTFF funding lets you implement modern solutions across your entire practice without shouldering the full cost.
      </p>
    </Fragment>
  </Content>


  <!-- FINAL CTA -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book a Free Consultation', href: 'https://calendly.com/causewaysoft' },
      { text: 'Start Your Transformation Today', href: '/contact' },
    ]}
  >
    <Fragment slot="title">Ready to Grow Your Clinic?</Fragment>
    <Fragment slot="subtitle">DTFF funding can cover up to 70% of your project costs.</Fragment>
  </CallToAction>

</Layout>