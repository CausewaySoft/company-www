---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import FeatureList from '~/components/widgets/FeatureCardsSimple.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Solutions for Healthcare | CausewaySoft',
  description: 'Transform your healthcare practice with our tailored digital solutions. Enhance patient care, streamline operations, and improve outcomes with CausewaySoft.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- HERO -->
  <Hero
    tagline="Solutions for healthcare"
    actions={[
      { variant: 'primary', text: 'Try it out', href: '' },
      { text: 'Contact Sales', href: '#contact' },
    ]}
    image={{ src: '~/assets/images/hero-team-dashboard.jpg', alt: 'Professional team using dashboards' }}
  >
    <Fragment slot="title">
      Improve productivity and create better patient experiences with our AI-powered Digital Operations Hub.
    </Fragment>

    <Fragment slot="subtitle">
      <strong>Enable your teams to focus on creating more impact - and keep your data secure.</strong>
    </Fragment>
  </Hero>

  <!-- QUICK NOTE / CTA 
    title="Deadline: < 2 weeks left! "
   
  -->
  <Note
    description="Elegible for <b>£20k funding</b> from DTFF. Modernise operations with minimal upfront cost. <br>Book a free consultation call."
  />

  <!-- 
      id="key-features"
    title="Key Features"
    subtitle="What you get with our Digital Operations Hub"
    tagline="Designed for healthcare teams"
  -->
  <FeatureList

    columns={4}
    items={[
      { 
        title: 'Automate documentation and admin tasks to improve care quality',
        image: {
          src: '~/assets/images/solutions/healthcare/feature-1.png',
          alt: '',
        }
    },
      { 
        title: 'Improve the care journey for patients and clinicians through AI-assisted tools',
        image: {
          src: '~/assets/images/solutions/healthcare/feature-2.png',
          alt: '',
        }
      },
      { 
        title: 'Connect ChatGPT to your internal systems like Google Drive, Outlook and more',
        image: {
          src: '~/assets/images/solutions/healthcare/feature-3.png',
          alt: '',
        }
      },
      { 
        title: 'Streamline clinical and operational workflows across teams',
        image: {
          src: '~/assets/images/solutions/healthcare/feature-4.png',
          alt: '',
        }
      }
    ]}
  />

  <!-- SOLUTION / DIGITAL OPERATIONS HUB (DETAILED FEATURES) -->
  <Features
    id="digital-operations-hub"
    tagline="Our Solution"
    title="Our Solution - The Digital Operations Hub"
    subtitle="A £25-28k package built for professional services firms. Measurable outcomes, not shiny toys."
    items={[
      { 
        title: 'Smart Client Portal',
        description: 'Secure document sharing, client task tracking, and e-signatures.',
        icon: 'tabler:folder', 
        image: 'https://images.unsplash.com/photo-1758691462370-cef1774278cd?ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&q=80&w=2532' },
      { title: 'Workflow Automation', description: 'Streamline lead → project → invoice processes; save hours per week.', icon: 'tabler:automatic-gearbox' },
      { title: 'Analytics Dashboard', description: 'Real-time performance tracking for staff, clients, and projects.', icon: 'tabler:chart-line' },
      { title: 'Integrated CRM', description: 'Custom-built for your firm’s processes, not a generic off-the-shelf tool.', icon: 'tabler:users' },
      { title: 'AI Document Assistant', description: 'Summarise, flag, and analyse client documents automatically.', icon: 'tabler:robot' },
      { title: 'Compliance & Audit Automation', description: 'Track GDPR, deadlines and quality control effortlessly.', icon: 'tabler:shield-check' },
      { title: 'Collaboration Layer', description: 'Multi-user access, messaging and shared workspaces with clients.', icon: 'tabler:message-circle' },
    ]}
  />

  <!-- EXAMPLE MINI-CASE -->
  <!-- <Content
    isReversed
    tagline="Example"
    title="Real impact — example outcome"
    items={[
      { title: 'Accounting firm outcome', description: 'Reduced manual invoice processing by 40% — more time for advisory work.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&w=1200&q=60',
      alt: 'Accounting dashboard example',
    }}
  /> -->

  <!-- BENEFITS / OUTCOMES (STATS & CALLS) -->
  <Stats
    stats={[
      { title: 'Time Savings', amount: '30–50%' },
      { title: 'Accuracy & Compliance', amount: 'Reduced errors' },
      { title: 'Business Intelligence', amount: 'Real-time dashboards' },
      { title: 'Client Experience', amount: 'Modern portals' },
    ]}
  />


  <CallToAction
    actions={[
      { variant: 'primary', text: '📅 Book Your Free DTFF Consultation', href: 'https://calendly.com/causewaysoft' },
    ]}
  >
    <Fragment slot="title">Ready to Transform Your Business?</Fragment>
    <Fragment slot="subtitle">
      The DTFF gives you a fast route to modernise operations — but the deadline is less than <strong>2 weeks away</strong>. Book a free consultation now.
    </Fragment>
  </CallToAction>


  <!-- MINI CASE -->
  <!-- <Content
    isAfterContent
    tagline="Mini-case"
    title="Mini-case: Accounting firm"
    items={[
      { title: 'Result', description: 'A 15-person accounting firm reduced invoice processing by 40% and secured £18,500 in DTFF funding.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1554224154-22dec7ec8818?auto=format&fit=crop&w=1200&q=60',
      alt: 'Team celebrating results',
    }}
  /> -->


  <!-- HOW IT WORKS (STEPS) -->
  <Steps
    title="How we deliver your Digital Operations Hub"
    items={[
      { title: 'Assessment & Audit', description: 'We evaluate systems, processes and opportunities.', icon: 'tabler:search' },
      { title: 'Implementation', description: 'Deploy CRM, portal, dashboard and AI modules.', icon: 'tabler:settings' },
      { title: 'Training & Adoption', description: 'Ensure staff adoption and measure early wins.', icon: 'tabler:school' },
      { title: 'Measure ROI', description: 'Track outcomes and iterate for continuous improvement.', icon: 'tabler:trending-up' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=60',
      alt: 'Process steps illustration',
    }}
  />


  <!-- TAILORED SOLUTIONS FOR SECTORS -->
  <section id="sectors" class="relative py-12">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-semibold mb-6">Tailored Solutions for Your Sector</h2>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 bg-white rounded-lg shadow">
          <h3 class="font-bold text-lg mb-2">For Accountants</h3>
          <p class="mb-3">Streamline client management, reporting, and compliance.</p>
          <ul class="list-disc list-inside text-sm space-y-1">
            <li>Automated invoicing, reminders, and reconciliation</li>
            <li>Client dashboards for real-time financial tracking</li>
            <li>AI-powered report generation and anomaly detection</li>
          </ul>
          <!-- <p class="mt-4 italic text-sm">Figma mockup placeholder: accountant dashboard animation / workflow screenshot</p> -->
        </div>

        <div class="p-6 bg-white rounded-lg shadow">
          <h3 class="font-bold text-lg mb-2">For Solicitors</h3>
          <p class="mb-3">Simplify case management and document workflows.</p>
          <ul class="list-disc list-inside text-sm space-y-1">
            <li>Secure client portal for document sharing</li>
            <li>Automated case updates, deadlines & task notifications</li>
            <li>AI-assisted document review and summarisation</li>
          </ul>
          <!-- <p class="mt-4 italic text-sm">Figma mockup placeholder: solicitor portal animation / workflow screenshot</p> -->
        </div>

        <div class="p-6 bg-white rounded-lg shadow">
          <h3 class="font-bold text-lg mb-2">Other Professional Services</h3>
          <p class="mb-3">Adapting solutions for consultancies, marketing agencies and more.</p>
          <ul class="list-disc list-inside text-sm space-y-1">
            <li>Custom reporting and automated client workflows</li>
            <li>Shared client portals and collaboration tools</li>
            <li>Rapid deployment to fit tight DTFF timelines</li>
          </ul>
          <!-- <p class="mt-4 italic text-sm">Figma mockup placeholder: generic dashboard animation / workflow screenshot</p> -->
        </div>
      </div>
    </div>
  </section>

    <!-- FAQ -->
  <FAQs
    title="FAQ"
    subtitle="Common questions about DTFF and our packages"
    tagline="Frequently Asked"
    items={[
      { title: 'Who is eligible?', description: 'Businesses trading 12+ months, 10–249 employees, Northern Ireland-based.' },
      { title: 'How much funding can I get?', description: '£5,000–£20,000 (up to 70% of project costs).' },
      { title: 'What technologies are supported?', description: 'AI, IoT, workflow automation, analytics dashboards, AR/VR, robotics, blockchain, and more.' },
      { title: 'How fast can the project be delivered?', description: 'Our packages are designed for rapid deployment to meet DTFF timelines.' },
    ]}
  />

   <!-- WHAT IS DTFF -->
  <Content
    id="what-is-dtff"
    tagline="What is the DTFF?"
    title="What is the Digital Transformation Flexible Fund (DTFF)?"
    video={{
      id: 'TBNTAH6w_9Q'
    }}
    >
    <Fragment slot="content">
      <p>
        The <strong>DTFF grant</strong> gives Northern Ireland SMEs up to <strong>£20,000</strong> to invest in technology and software that accelerates growth and efficiency.
      </p>

      <ul class="list-disc list-inside mt-4 space-y-2">
        <li>Covers up to <strong>70%</strong> of project costs</li>
        <li>Eligible for <strong>Micro</strong> (1-10 FTE) and <strong>Small</strong> (10-49 FTEs) Northern Irish businesses trading for <strong>12+ months</strong></li>
        <li>Supports technologies such as <em>AI, IoT, workflow automation, analytics dashboards, AR/VR, robotics, blockchain</em>, and more</li>
      </ul>

      <p class="mt-4">
        <strong>Why this matters:</strong> Most small businesses still struggle with manual processes and legacy systems. DTFF funding lets you implement modern solutions without shouldering the full cost.
      </p>
    </Fragment>
  </Content>


  <!-- FINAL CTA with urgency -->
  <CallToAction
    actions={[
      { variant: 'primary', text: '📅 Book Your Free DTFF Consultation', href: 'https://calendly.com/causewaysoft' },
    ]}
  >
    <Fragment slot="title">Secure Your DTFF-Funded Transformation</Fragment>
    <Fragment slot="subtitle">
      Limited slots available. Deadline: <strong>less than 2 weeks!</strong> Reserve your free consultation and start the application process.
    </Fragment>
  </CallToAction>

</Layout>