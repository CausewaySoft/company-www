---
import { GoogleAnalytics } from '@astrolib/analytics';
import { ANALYTICS } from 'astrowind:config';

const id = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;

console.log("DEBUGGER: id: ", id);


if (!id) {
console.log("DEBUGGER: not null !!!!");
  return null;
}

---

{
  <GoogleAnalytics
    id={id}
    partytown={ANALYTICS?.vendors?.googleAnalytics?.partytown}
  />
}
