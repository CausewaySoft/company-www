---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import Image from '~/components/common/Image.astro';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  defaultIcon,
  image = await Astro.slots.render('image'),
  bodyText,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  {
    image && (
      <div class="flex flex-col mb-8 md:mx-auto md:mb-12">
        {typeof image === 'string' ? (
          <Fragment set:html={image} />
        ) : (
          <Image
            width={333}
            height={333}
            widths={[400, 768]}
            sizes="(max-width: 768px) 100vw, 432px"
            layout="fixed"
            class="grayscale hover:grayscale-0 rounded-md shadow-lg self-center"
            {...image}
          />
        )}
      </div>
    )
  }
  {
    bodyText && (
  <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
    <p class="mt-4 text-muted text-center text-xl my-4 mb-12">
      {bodyText}
    </p>
  </div>
  )}


