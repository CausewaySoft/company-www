---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

// import type { Steps as Props } from '~/types';
import FormContainer from '~/components/ui/Form.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  items = [],
  isReversed = false,
  formInputs = [],
  textarea,
  disclaimer,
  button,
  description,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-3xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class={`flex flex-col gap-8 md:gap-12 md:flex-row ${isReversed ? 'md:flex-row-reverse' : ''}`}>
    <div class={`w-full lg:w-1/2 gap-8 md:gap-12 ${isReversed ? 'lg:ml-16 md:ml-8 ml-0' : 'lg:mr-16 md:mr-8 mr-0'}`}>
      <div class="w-full text-center md:text-left rtl:md:text-right">
        {
          formInputs && (
            <>
              {/* <h4 class="text-2xl font-semibold mb-6 font-heading">Contact Form</h4> */}
              <div class="flex flex-col max-w-xl mx-auto rounded-lg backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow p-4 sm:p-6 lg:p-8 w-full">
                <FormContainer
                  id="contact-form"
                  inputs={formInputs}
                  textarea={textarea}
                  disclaimer={disclaimer}
                  button={button}
                  description={description}
                  action={{
                    url: 'http://localhost:4321/services/forms/contact.php',
                    method: 'post',
                  }}
                />
              </div>
            </>
          )
        }
      </div>
    </div>
    <div class="mx-auto lg:w-1/2 px-0 order-first md:order-last">
      <!-- <h4 class="text-2xl text-center font-semibold mb-6 font-heading">Quick Links</h4> -->
      <ul class="space-y-10">
        {
          items && items.length
            ? items.map(({ title: title2, description, classes, href, icon }, index: number) => (
                <li class="flex md:-mx-4">
                  <div class="pr-4 sm:pl-4 rtl:pr-0 rtl:pl-4 rtl:sm:pl-0 rtl:sm:pr-4">
                    <span class="flex w-16 h-16 mx-auto items-center justify-center text-2xl font-bold rounded-full bg-blue-100 text-primary">
                      {icon ? <Icon name={icon} class="w-6 h-6 icon-bold" /> : index + 1}
                    </span>
                  </div>
                  <div class={`pl-4 rtl:pl-0 rtl:pr-4 ${classes?.container ?? ''}`}>
                    {title2 && <h3 class="mb-2 text-xl font-semibold font-heading" set:html={title2} />}
                    <a
                      class={`text-muted dark:text-gray-400 ${classes?.ctaLinks ?? ''}`}
                      target="_blank"
                      href={href}
                      set:html={description}
                    />
                  </div>
                </li>
              ))
            : ''
        }
      </ul>
    </div>
  </div>
</WidgetWrapper>
