---
import SectionHead from './SectionHead.astro';

export interface Service {
  title: string;
  description: string;
  href: string;
  /** What's inside the service, shown as a mono line */
  sections?: string[];
}

export interface Props {
  id?: string;
  services: Service[];
  title?: string;
  lede?: string;
}

const {
  id = 'services',
  services,
  title = 'Two things, done properly.',
  lede = 'Websites that win you business, and custom software that builds a product or improves how your business operates. AI and automation are part of both.',
} = Astro.props;
---

<section class="services bs-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="bs-wrap">
    <SectionHead id={`${id}-title`} index="01" label="What we build" title={title} lede={lede} />

    <ol class="svc">
      {
        services.map((s, i) => (
          <li data-reveal>
            <a class="svc__row bs-grid" href={s.href}>
              <span class="svc__num bs-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__title bs-display">{s.title}</span>
              <span class="svc__desc">
                {s.description}
                {s.sections?.length && <span class="svc__sections bs-mono">{s.sections.join(' · ')}</span>}
              </span>
              <span class="svc__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .svc {
    margin-top: clamp(48px, 7vw, 96px);
    border-bottom: 1px solid var(--bs-rule);
  }

  .svc__row {
    position: relative;
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--bs-rule);
    row-gap: 12px;
    align-items: baseline;
    color: var(--bs-text);
  }

  /* Signal rule that draws across on hover/focus */
  .svc__row::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    background: var(--bs-signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--bs-ease);
  }

  .svc__row:hover::before,
  .svc__row:focus-visible::before {
    transform: scaleX(1);
  }

  .svc__num {
    grid-column: 1 / span 2;
  }

  .svc__title {
    grid-column: 3 / -1;
    font-size: clamp(36px, 5.2vw, 76px);
    transition: transform 0.6s var(--bs-ease);
  }

  .svc__row:hover .svc__title {
    transform: translateX(8px);
  }

  .svc__desc {
    grid-column: 3 / -1;
    font-size: 16px;
    line-height: 1.55;
    max-width: 30em;
  }

  .svc__sections {
    display: block;
    margin-top: 12px;
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 13px;
    color: var(--bs-text);
  }

  .svc__arrow {
    display: none;
  }

  @media (min-width: 900px) {
    .svc__num {
      grid-column: 1 / span 1;
    }
    .svc__title {
      grid-column: 2 / span 6;
    }
    /* Text column: same edge as the section ledes and project text */
    .svc__desc {
      grid-column: 9 / -1;
      padding-right: 56px;
    }
    .svc__arrow {
      display: block;
      position: absolute;
      right: 0;
      top: 50%;
      margin-top: -0.6em;
      font-size: 28px;
      color: var(--bs-ink);
      transition:
        transform 0.6s var(--bs-ease),
        color 0.3s;
    }
    .svc__row:hover .svc__arrow {
      transform: translateX(6px);
      color: var(--bs-signal);
    }
  }
</style>
