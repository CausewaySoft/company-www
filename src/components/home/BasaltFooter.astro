---
/**
 * Footer for the Basalt pages. Deliberately quiet: the brand block and one
 * mono row of essentials. The closing CTA above it carries the actions.
 *
 * `services` is optional: pages without their own services index (e.g.
 * /contact, inner pages) can pass it to show a single inline row of
 * service links. The home page leaves it out.
 */
interface FooterLink {
  text: string;
  href: string;
  external?: boolean;
}

export interface Props {
  links: FooterLink[];
  services?: FooterLink[];
}

const { links, services } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bsf">
  <div class="bs-wrap">
    <div class="bsf__main bs-grid">
      <a class="bsf__logo" href="/" aria-label="CausewaySoft, home">
        <svg class="bsf__mark" viewBox="0 0 110.46 96.471" aria-hidden="true">
          <path
            d="M265.875-657.46c7.858,15.2-14.5-27.784-14.5-27.784L277.2-730.056h51.814l25.815,44.8-25.845,44.669H277.119s49.592-84.768,41.205-70.58"
            transform="translate(-247.871 733.556)"
            fill="none"
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="7"></path>
        </svg>
        <span class="bsf__word">CausewaySoft</span>
      </a>
      <p class="bsf__tagline bs-display">Giant apps for giant visionaries.</p>
    </div>

    {
      services?.length && (
        <nav class="bsf__services" aria-label="Services">
          <span class="bs-mono">Services</span>
          <ul>
            {services.map((s) => (
              <li>
                <a href={s.href}>{s.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="bsf__base bs-mono">
      <p>© {year} CausewaySoft Ltd · Registered in Northern Ireland, NI669195</p>
      <ul class="bsf__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.text}
                {l.external && (
                  <>
                    <span aria-hidden="true"> ↗</span>
                    <span class="sr-only">(opens in a new tab)</span>
                  </>
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="bsf__top" href="#">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .bsf {
    color: var(--bs-text);
    font-family: var(--bs-font-text);
    background: var(--bs-bg);
    border-top: 1px solid var(--bs-rule);
  }

  .bsf__main {
    row-gap: 24px;
    padding-block: clamp(56px, 7vw, 96px) clamp(40px, 5vw, 64px);
    align-items: end;
  }

  .bsf__logo,
  .bsf__tagline {
    grid-column: 1 / -1;
  }

  .bsf__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--bs-ink);
  }

  .bsf__mark {
    width: 30px;
    height: auto;
  }

  .bsf__word {
    font-family: var(--bs-font-display);
    font-stretch: 75%;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    line-height: 1;
  }

  .bsf__tagline {
    margin-top: 8px;
    font-size: clamp(40px, 5vw, 72px);
    max-width: 12ch;
  }

  /* Optional inline services row */
  .bsf__services {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 32px;
    padding-block: 20px;
    border-top: 1px solid var(--bs-rule);
  }

  .bsf__services ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .bsf__services a {
    font-size: 15px;
    color: var(--bs-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.2s var(--bs-ease);
  }

  .bsf__services a:hover {
    text-decoration-color: var(--bs-signal);
  }

  .bsf__base {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    align-items: center;
    padding-block: 24px 32px;
    border-top: 1px solid var(--bs-rule);
  }

  .bsf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .bsf__base a {
    color: var(--bs-ink);
    transition: color 0.2s;
  }

  .bsf__base a:hover {
    color: var(--bs-signal);
  }

  .bsf__top {
    margin-left: auto;
  }

  .bsf :focus-visible {
    outline: 2px solid var(--bs-signal);
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .bsf__tagline {
      grid-column: 1 / span 7;
    }
  }
</style>
