---
/**
 * Home hero.
 *
 * Composition: the headline sits top-left in the drawing's "sky"; the
 * charcoal Causeway study is mirrored so its basalt cliff rises on the
 * right and the stones run under the text. Type and stone balance each
 * other on the diagonal, and the drawing is visible in the first screen.
 */
import { Image } from 'astro:assets';
import causewayDrawing from '~/assets/images/giants-causeway-causewaysoft-herobg.png';

// `services` is still accepted (but not rendered) so the services index can
// return without touching the page (see git history).
export interface Props {
  services: { title: string; href: string }[];
}
---

<section class="hero" aria-labelledby="hero-title">
  <div class="bs-wrap hero__content">
    <div class="hero__meta bs-mono">
      <p>Independent software studio · Belfast, NI.</p>
      <p class="hero__meta-right">Giant apps for giant visionaries</p>
    </div>

    <h1 id="hero-title" class="hero__title bs-display">
      <!--
        First line is "typed": highlighted in the selection colour, then the
        script types a word plus "...", pauses (caret blinks; on the first pause only, the
        "Start a project" button gets a highlighter stroke, which stays),
        backspaces it and types the next. Screen readers and no-JS visitors
        get the static "Software,".
      -->
      <span class="hero__line hero__type" data-hero-type>
        <span class="sr-only">Software,</span>
        <span class="hero__typed" aria-hidden="true"
          ><span class="hero__word">Software,</span><span class="hero__dots"></span></span
        ><span class="hero__caret" aria-hidden="true"></span>
      </span>
      <span class="hero__line">built like the</span>
      <span class="hero__line">Giant’s Causeway<span class="hero__stop">.</span></span>
    </h1>

    <div class="hero__foot">
      <p class="hero__lede bs-lede">
        Precisely engineered, creative and built to last.
        <br/><br/>
        Custom software: from blazing fast and semantic websites, to offline-first progessive web applications, with a possibility to add AI tools.
        <br/>
        <br/>
        Welcome to the new era of software.
        <br/>
        Welcome to CausewaySoft! </p>
      <div class="hero__actions">
        <a class="bs-btn hero__cta" href="/contact?type=project" data-hero-mark
          ><span class="hero__cta-ink"
            ><span>Start a project</span> <span class="bs-arrow" aria-hidden="true">→</span></span
          ></a
        >
        <a class="bs-link" href="#work">See the work</a>
      </div>
    </div>
  </div>
</section>

<!--
  The drawing sits outside the hero section so it can stay pinned for the
  whole page: the sections after it are opaque and scroll over it.
-->
<figure class="hero__ground" data-hero-ground>
  <div class="hero__drawing">
    <Image
      src={causewayDrawing}
      alt="Charcoal drawing of the basalt columns of the Giant’s Causeway"
      widths={[768, 1436]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <figcaption class="bs-wrap bs-mono">
    <span>Fig. 01</span>
    <span>Giant’s Causeway, Co. Antrim<span class="hero__caption-detail"> · charcoal study</span></span>

    <!--
      TODO:
      1. can we replace that a.href link to google maps and instead of coordinates use google plus code?: 6FQQ+JR Bushmills -->

    <a
      class="hero__coords"
      href="https://www.google.com/maps/place/Giant's+Causeway+Viewpoint/@55.2408,-6.5141749,1156m/data=!3m1!1e3!4m12!1m5!3m4!2zNTXCsDE0JzI2LjkiTiA2wrAzMCc0MS44Ilc!8m2!3d55.2408056!4d-6.5116111!3m5!1s0x4860299016f13455:0xbe35bf015dee5303!8m2!3d55.2391073!4d-6.5104552!16s%2Fg%2F11l5h7vsls"
      target="_blank"
      rel="noopener"
      aria-label="55.2408° N, 6.5116° W: the Giant’s Causeway on Google Maps (opens in a new tab)"
    >
      55.2408° N, 6.5116° W
    </a>
  </figcaption>
</figure>

<style>
  /* Hero text stays above the pinned drawing and scrolls away normally */
  .hero {
    position: relative;
    z-index: 1;
    /* The button's highlighter stroke may reach past the edge on phones */
    overflow-x: clip;
  }

  /* Content sits above the drawing, which slides up underneath it */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(28px, 4.5vw, 56px);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
  }

  .hero__title {
    margin-top: clamp(36px, 5vw, 72px);
    font-size: clamp(52px, 8.6vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    font-weight: 800;
    font-stretch: 68%;
    text-wrap: balance;
  }

  .hero__stop {
    color: var(--bs-signal);
  }

  /* Typed first line: always its own line, never wraps, so the headline
     never changes height while words come and go */
  .hero__type {
    display: block;
    white-space: nowrap;
  }

  /* Looks like selected text, in the site's ::selection colours */
  .hero__typed {
    background: var(--bs-signal);
    color: var(--bs-signal-ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero__typed:has(.hero__word:empty):has(.hero__dots:empty) {
    background: none;
  }

  /* Caret only once the script runs; solid while typing, blinks when idle */
  .hero__caret {
    display: none;
    width: 0.06em;
    height: 0.78em;
    margin-left: 0.05em;
    background: currentColor;
    vertical-align: -0.04em;
  }

  .hero__type[data-state] .hero__caret {
    display: inline-block;
  }

  .hero__type[data-state='waiting'] .hero__caret {
    animation: hero-caret 1s steps(1) infinite;
  }

  @keyframes hero-caret {
    50% {
      opacity: 0;
    }
  }

  /*
   * Hero "Start a project": outline button (hero only; .bs-btn stays filled
   * elsewhere), which gets a highlighter stroke once, during the headline's
   * first typing pause, and keeps it.
   *
   * The stroke is a marker in the selection colours, reaching 33px past
   * the button's sides and 13px past its top and bottom, dragged across
   * it by hand: a beat to start, a
   * slight tilt, a ragged chisel-tip start, wobbling edges and a frayed
   * end. The outline ring is drawn above it (::after), and the label and
   * arrow turn selection-ink exactly where the stroke covers them (a
   * moving gradient clipped to the text, sized to the stroke's box).
   *
   * Colours are custom properties so hover can swap them: once marked,
   * hovering turns the stroke ink and the text background-coloured, like
   * the filled button's hover.
   */
  .bs-btn.hero__cta {
    --mark-out-x: 33px;
    --mark-out-y: 13px;
    --mark-color: var(--bs-signal);
    --mark-text: var(--bs-signal-ink);
    position: relative;
    isolation: isolate;
    background: transparent;
    color: var(--bs-ink);
  }

  .bs-btn.hero__cta:hover {
    background: var(--bs-ink);
    color: var(--bs-bg);
    --mark-color: var(--bs-ink);
    --mark-text: var(--bs-bg);
  }

  /* Outline ring, above the stroke (same size as the old inset ring) */
  .hero__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    box-shadow: inset 0 0 0 1px var(--bs-ink);
    pointer-events: none;
  }

  /* The stroke */
  .hero__cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(-1 * var(--mark-out-y)) calc(-1 * var(--mark-out-x));
    /* Ink pools where the pen lands and lifts (darker ends), with faint
       streaks along the stroke */
    background:
      repeating-linear-gradient(0deg, transparent 0 2px, color-mix(in srgb, var(--mark-text) 4%, transparent) 2px 3px),
      /* Deeper colour pooled under the label, fading out to the edges */
      radial-gradient(
        ellipse 50% 55% at 50% 50%,
        color-mix(in srgb, var(--mark-color) 70%, #000) 0,
        color-mix(in srgb, var(--mark-color) 82%, #000) 45%,
        transparent 100%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--mark-color) 82%, var(--mark-text)) 0,
        var(--mark-color) 7%,
        var(--mark-color) 93%,
        color-mix(in srgb, var(--mark-color) 85%, var(--mark-text)) 100%
      );
    /* Hand-drawn outline: ragged, slanted start; wobbling top and bottom;
       frayed end where the pen lifts */
    clip-path: polygon(
      3.5% 15%,
      6% 7%,
      11% 4.5%,
      21% 3.5%,
      34% 5%,
      49% 2.5%,
      63% 4%,
      78% 2%,
      91% 3.5%,
      95% 1%,
      97.5% 7%,
      98.6% 18%,
      99.6% 30%,
      98.4% 42%,
      100% 55%,
      98.8% 68%,
      99.4% 80%,
      97.4% 90%,
      93% 97%,
      79% 98.5%,
      64% 96%,
      49% 99%,
      35% 96.5%,
      20% 100%,
      8% 97.5%,
      3.5% 92%,
      1.4% 81%,
      0.4% 68%,
      1.6% 55%,
      0 42%,
      1.2% 29%
    );
    transform: rotate(-1.2deg) scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  /* Text box stretched (padding, cancelled by margin) to exactly the
     stroke's box, so its gradient edge tracks the stroke's leading edge */
  .hero__cta-ink {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    padding: calc(var(--mark-out-y) + 1em) calc(var(--mark-out-x) + 1.4em);
    margin: calc(-1 * var(--mark-out-y) - 1em) calc(-1 * var(--mark-out-x) - 1.4em);
    pointer-events: none;
  }

  .hero__cta.is-marked::before {
    transform: rotate(-1.2deg) scaleX(1);
    animation: hero-mark 0.9s linear both;
  }

  .hero__cta.is-marked .hero__cta-ink {
    background: linear-gradient(90deg, currentColor 0 33.34%, var(--mark-text) 33.34% 66.67%, currentColor 66.67% 100%);
    background-size: 300% 100%;
    background-position: 50% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-mark-ink 0.9s linear both;
  }

  @keyframes hero-mark {
    0%,
    18% {
      transform: rotate(-1.2deg) scaleX(0);
      animation-timing-function: cubic-bezier(0.45, 0.05, 0.25, 1);
    }
    100% {
      transform: rotate(-1.2deg) scaleX(1);
    }
  }

  @keyframes hero-mark-ink {
    0%,
    18% {
      background-position: 100% 0;
      animation-timing-function: cubic-bezier(0.45, 0.05, 0.25, 1);
    }
    100% {
      background-position: 50% 0;
    }
  }

  /* Once the stroke is down (is-done, added on animationend): the outline
     ring goes, and the label and arrow grow bolder and turn white. The text
     grows by transform, so the button and the stroke keep their size; the
     scaled label reaches into the stroke's overhang. */
  .hero__cta::after {
    transition: opacity 0.35s var(--bs-ease);
  }

  .hero__cta-ink {
    transition: transform 0.35s var(--bs-ease);
  }

  .hero__cta.is-done {
    --mark-text: #fff;
    font-weight: 700;
  }

  .hero__cta.is-done::after {
    opacity: 0;
  }

  .hero__cta.is-done .hero__cta-ink {
    transform: scale(1.4);
  }

  .hero__cta.is-done .bs-arrow {
    transform: scale(1.2);
  }

  .hero__cta.is-done:hover .bs-arrow {
    transform: translateX(3px) scale(1.2);
  }

  /* Reduced motion: the stroke is simply there */
  @media (prefers-reduced-motion: reduce) {
    .hero__cta.is-marked::before,
    .hero__cta.is-marked .hero__cta-ink {
      animation: none;
    }
  }

  .hero__foot {
    margin-top: clamp(28px, 3.5vw, 48px);
    display: grid;
    /* Room for the stroke above the button when the actions stack */
    gap: 28px;
  }

  /* Gaps leave room for the stroke's overhang (33px sides, 13px top and bottom) */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 52px;
  }

  /* Drawing: mirrored so the cliff stands on the right */
  .hero__ground {
    position: relative;
    z-index: 0;
    margin-top: 12px;
  }

  /* Pinned where it first appears; the script measures that position.
     Without JS the drawing simply scrolls with the page. */
  .hero__ground.is-pinned {
    position: sticky;
    top: var(--ground-top, 0px);
  }

  .hero__drawing img {
    display: block;
    width: 100%;
    height: auto;
    transform: scaleX(-1);
    opacity: var(--bs-drawing-opacity);
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }

  /* The ground settles into place on load (CSS only, never hides text) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__drawing {
      /* Gentler than --bs-ease, which front-loads the motion and would
         make the long rise look quick */
      animation: hero-rise 2.4s cubic-bezier(0.3, 0.15, 0.2, 1) both;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(72px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__ground figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 12px;
    /* Decorative: a step quieter than the hero eyebrow */
    font-size: 11px;
    color: var(--bs-muted);
    /* Room for the next section's feathered edge, so the caption stays crisp */
    padding-bottom: var(--bs-feather);
  }

  .hero__coords {
    margin-left: auto;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
    transition:
      color 0.2s var(--bs-ease),
      text-decoration-color 0.2s var(--bs-ease);
  }

  .hero__coords:hover,
  .hero__coords:focus-visible {
    color: var(--bs-ink);
    text-decoration-color: var(--bs-signal);
  }

  /* Small screens: crop in on the cliff so the drawing still registers,
     and keep the meta and caption to one line each */
  @media (max-width: 767px) {
    .hero__meta-right,
    .hero__caption-detail,
    .hero__coords {
      display: none;
    }

    .hero__drawing {
      overflow: hidden;
    }

    .hero__drawing img {
      width: 175%;
      max-width: none;
      margin-left: -75%;
    }

    /* The button gets its own row, with the link centred under it. Inset
       by the stroke's side overhang so the stroke and the enlarged label
       stay inside the page margin. */
    .hero__actions {
      flex-direction: column;
      align-items: center;
      width: fit-content;
      margin-left: 33px;
    }
  }

  @media (min-width: 768px) {
    .hero__line {
      display: block;
    }

    .hero__foot {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(16px, 2vw, 32px);
      align-items: end;
    }

    .hero__lede {
      grid-column: 1 / span 6;
    }

    /* Two columns: button and link share one row. The gap still clears
       the stroke's 33px overhang. */
    .hero__actions {
      grid-column: 7 / span 6;
      justify-content: flex-start;
      flex-wrap: nowrap;
      column-gap: 44px;
    }

    .hero__ground {
      margin-top: -14vw;
    }
  }

  @media (min-width: 1024px) {
    .hero__lede {
      grid-column: 1 / span 5;
    }
    /* Keep actions clear of the cliff, which rises in the last columns */
    .hero__actions {
      grid-column: 6 / span 5;
    }
  }
</style>

<script>
  // Pin the drawing at the spot where it first renders, so the page
  // scrolls over it. Measured on load and resize only, no scroll handler.
  function initHeroGround() {
    const ground = document.querySelector<HTMLElement>('[data-hero-ground]');
    if (!ground) return;

    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    const pin = () => {
      ground.classList.remove('is-pinned');
      const naturalTop = ground.getBoundingClientRect().top + window.scrollY;
      // Never pin lower than half the drawing's height above the fold
      const maxTop = window.innerHeight - ground.offsetHeight * 0.5;
      ground.style.setProperty('--ground-top', `${Math.max(0, Math.min(naturalTop, maxTop))}px`);
      ground.classList.add('is-pinned');
    };

    pin();
    let raf = 0;
    window.addEventListener(
      'resize',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(pin);
      },
      { signal: ac.signal }
    );
  }

  document.addEventListener('astro:page-load', initHeroGround);

  // Typed first line of the headline. Keeps "Software," on screen at load
  // (no blank headline), backspaces the comma, types "...", pauses, then
  // deletes and types the next word, forever. Skips words that won't fit
  // on one line at the current width. Off for reduced motion.
  const WORDS = ['Software', 'Websites', 'Web-Apps', 'Ideas', 'Dreams'];
  const PAUSE_MS = 3000;

  function initHeroType() {
    const root = document.querySelector<HTMLElement>('[data-hero-type]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    // Reduced motion: no typing, and the button's highlight is just there
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelector('[data-hero-mark]')?.classList.add('is-marked', 'is-done');
      return;
    }

    const word = root.querySelector<HTMLElement>('.hero__word');
    const dots = root.querySelector<HTMLElement>('.hero__dots');
    const title = root.closest('h1');
    if (!word || !dots || !title) return;

    let stopped = false;
    let timer = 0;
    document.addEventListener(
      'astro:before-swap',
      () => {
        stopped = true;
        clearTimeout(timer);
      },
      { once: true }
    );

    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const wait = (ms: number) =>
      new Promise<void>((resolve, reject) => {
        timer = window.setTimeout(() => (stopped ? reject(new Error('stopped')) : resolve()), ms);
      });

    // Fast but uneven, with the odd hesitation
    const keystroke = () => rand(55, 140) + (Math.random() < 0.12 ? rand(180, 380) : 0);
    // Steady, human backspacing
    const backstroke = () => rand(70, 105);

    // Hidden copy of the line, to check a word fits before typing it
    const measure = document.createElement('span');
    measure.className = 'hero__typed';
    measure.setAttribute('aria-hidden', 'true');
    measure.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;left:0;top:0';
    title.style.position = 'relative';
    title.append(measure);
    const fits = (w: string) => {
      measure.textContent = `${w}...`;
      return measure.getBoundingClientRect().width <= title.clientWidth * 0.96;
    };

    const typeWord = async (text: string) => {
      for (const ch of text) {
        word.textContent += ch;
        await wait(keystroke());
      }
    };
    const typeDots = async () => {
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.textContent = '.';
        dots.append(dot);
        await wait(rand(110, 200));
      }
    };
    const backspace = async (chars: number) => {
      for (let i = 0; i < chars; i++) {
        if (dots.lastChild) dots.lastChild.remove();
        else word.textContent = (word.textContent ?? '').slice(0, -1);
        await wait(backstroke());
      }
    };
    const clearAll = () => backspace(dots.childElementCount + (word.textContent ?? '').length);

    // Highlighter stroke over the "Start a project" button; it stays
    const button = document.querySelector<HTMLElement>('[data-hero-mark]');
    // When the stroke has been drawn, drop the outline and set the label bold
    // and white (is-done)
    const markButton = () => {
      if (!button) return;
      button
        .querySelector('.hero__cta-ink')
        ?.addEventListener('animationend', () => button.classList.add('is-done'), { once: true });
      button.classList.add('is-marked');
    };

    const run = async () => {
      root.dataset.state = 'typing';
      let current = 'Software';
      await wait(900);
      await backspace(1); // the comma
      await wait(rand(150, 260));

      for (let pause = 0; ; pause++) {
        await typeDots();
        root.dataset.state = 'waiting';
        if (pause === 0) markButton();
        await wait(PAUSE_MS);
        root.dataset.state = 'typing';
        await clearAll();
        await wait(rand(450, 700));

        const options = WORDS.filter((w) => w !== current && fits(w));
        current = options[Math.floor(Math.random() * options.length)] ?? 'Software';
        await typeWord(current);
      }
    };

    run().catch(() => {
      /* stopped on page swap */
    });
  }

  document.addEventListener('astro:page-load', initHeroType);
</script>
