---
/**
 * Home hero.
 *
 * Composition: the headline sits top-left in the drawing's "sky"; the
 * charcoal Causeway study is mirrored so its basalt cliff rises on the
 * right and the stones run under the text. Type and stone balance each
 * other on the diagonal, and the drawing is visible in the first screen.
 */
import { Image } from 'astro:assets';
import causewayDrawing from '~/assets/images/giants-causeway-causewaysoft-herobg.png';

export interface Props {
  services: { title: string; href: string }[];
}

// `services` is kept so the services index can return (see git history).
const { services: _services } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="bs-wrap hero__content">
    <div class="hero__meta bs-mono">
      <p>Independent software studio · Belfast, Northern Ireland</p>
      <p class="hero__meta-right">Giant apps for giant visionaries</p>
    </div>

    <h1 id="hero-title" class="hero__title bs-display">
      <span class="hero__line">Software,</span>
      <span class="hero__line">built like the</span>
      <span class="hero__line">Giant’s Causeway<span class="hero__stop">.</span></span>
    </h1>

    <div class="hero__foot">
      <p class="hero__lede bs-lede">
        We design and engineer websites, web applications, AI tools and custom software: precise, modular and built to
        last.
      </p>
      <div class="hero__actions">
        <a class="bs-btn" href="/contact">Start a project <span class="bs-arrow" aria-hidden="true">→</span></a>
        <a class="bs-link" href="#work">See the work</a>
      </div>
    </div>
  </div>

  <figure class="hero__ground">
    <div class="hero__drawing">
      <Image
        src={causewayDrawing}
        alt="Charcoal drawing of the basalt columns of the Giant’s Causeway"
        widths={[768, 1436]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <figcaption class="bs-wrap bs-mono">
      <span class="hero__fig">Fig. 01</span>
      <span>Giant’s Causeway, Co. Antrim<span class="hero__caption-detail"> · charcoal study</span></span>
      <span class="hero__coords">55.2408° N, 6.5116° W</span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  /* Content sits above the drawing, which slides up underneath it */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(28px, 4.5vw, 56px);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
  }

  .hero__title {
    margin-top: clamp(36px, 5vw, 72px);
    font-size: clamp(52px, 8.6vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    font-weight: 800;
    font-stretch: 68%;
    text-wrap: balance;
  }

  .hero__stop {
    color: var(--bs-signal);
  }

  .hero__foot {
    margin-top: clamp(28px, 3.5vw, 48px);
    display: grid;
    gap: 28px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  /* Drawing: mirrored so the cliff stands on the right */
  .hero__ground {
    position: relative;
    margin-top: 12px;
  }

  .hero__drawing img {
    display: block;
    width: 100%;
    height: auto;
    transform: scaleX(-1);
    opacity: var(--bs-drawing-opacity);
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }

  /* The ground settles into place on load (CSS only, never hides text) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__drawing {
      animation: hero-rise 1.4s var(--bs-ease) both;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__ground figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: -12px;
    padding-bottom: 8px;
  }

  .hero__fig {
    color: var(--bs-ink);
  }

  .hero__coords {
    margin-left: auto;
  }

  /* Small screens: crop in on the cliff so the drawing still registers,
     and keep the meta and caption to one line each */
  @media (max-width: 767px) {
    .hero__meta-right,
    .hero__caption-detail,
    .hero__coords {
      display: none;
    }

    .hero__drawing {
      overflow: hidden;
    }

    .hero__drawing img {
      width: 175%;
      max-width: none;
      margin-left: -75%;
    }
  }

  @media (min-width: 768px) {
    .hero__line {
      display: block;
    }

    .hero__foot {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(16px, 2vw, 32px);
      align-items: end;
    }

    .hero__lede {
      grid-column: 1 / span 6;
    }

    /* Keep actions clear of the cliff, which rises in the last columns */
    .hero__actions {
      grid-column: 7 / span 4;
      justify-content: flex-start;
    }

    .hero__ground {
      margin-top: -14vw;
    }
  }

  @media (min-width: 1024px) {
    .hero__lede {
      grid-column: 1 / span 5;
    }
    .hero__actions {
      grid-column: 6 / span 4;
    }
  }
</style>
