---
/**
 * Page transition, option A "basalt columns" (docs/motion-plan.md, chosen
 * by Mateusz). On a page change, grained columns rise from the ground,
 * staggered and with uneven slanted tops, until they cover the page; the
 * next page loads behind them; then they sink back into the ground.
 *
 * - The header stays visible and still: the columns rise under it (they
 *   start below the 60px scrolled header), and the default cross-fade is
 *   switched off in basalt.css, so nothing fades out and back in.
 * - The columns and the page fetch run in parallel, so the transition adds
 *   almost no wait: about 0.3s up, the swap, about 0.3s down.
 * - On a slow connection a thin signal line draws along the top of the
 *   columns while they wait.
 * - Same-page links (#anchors) never trigger it; the router doesn't.
 * - Reduced motion: no columns, an instant swap.
 *
 * Rendered by BasaltHeader, so every Basalt page has it, and persisted
 * across page changes so the same element rises on one page and sinks on
 * the next.
 */

// Columns come in groups of three (Mateusz's direction): each group rises
// and sinks together, shaped / ‾ \ like the top of a basalt column. Groups
// start at irregular times, spread over --bsx-stagger, like stones
// settling. Phones show the first two groups.
const GROUP_DELAYS = [90, 0, 150, 40];
const FACES = ['rise', 'flat', 'fall'] as const; // '/', flat, '\'
const columns = GROUP_DELAYS.flatMap((d) => FACES.map((face) => ({ d, face })));
---

<div class="bsx" data-bs-columns data-state="idle" aria-hidden="true" transition:persist="bs-columns">
  {columns.map((c) => <span class={`bsx__col bsx__col--${c.face}`} style={`--d:${c.d}ms`} />)}
  <span class="bsx__wait"></span>
</div>

<style>
  .bsx {
    /* Each column's rise and sink time, and the spread of start times
       across the groups (the latest of GROUP_DELAYS). The script waits
       for --bsx-up + --bsx-stagger before swapping. Total stays ~0.7s. */
    --bsx-up: 200ms;
    --bsx-down: 220ms;
    --bsx-stagger: 150ms;
    position: fixed;
    inset: 60px 0 0 0;
    z-index: 30;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }

  .bsx[data-state='cover'],
  .bsx[data-state='reveal'] {
    visibility: visible;
  }

  .bsx__col {
    flex: 1;
    /* Taller than the space, so the slanted tops still cover the top edge */
    height: calc(100% + 16vh);
    margin-right: -1px;
    --tone: #1d2023;
    /* Grain at the site's --bs-grain-opacity (a touch stronger, so the
       stone has texture), veiled in the column's own tone */
    --veil: color-mix(in srgb, var(--tone) calc((1 - var(--bs-grain-opacity) * 1.5) * 100%), transparent);
    background:
      linear-gradient(var(--veil), var(--veil)),
      var(--bs-grain) 0 0 / 240px 240px,
      var(--tone);
    transform: translateY(100%);
  }

  /* A group of three reads as one stone, / ‾ \, shaded like a lit prism:
     left face mid-tone, flat top face lightest, right face darkest */
  .bsx__col--rise {
    --tone: #1d2023;
    clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 100%);
    /* Dark joint between stones (not between faces of one stone) */
    border-left: 4px solid #070808;
    box-shadow: inset 1px 0 0 rgb(255 255 255 / 0.09);
  }

  .bsx__col--flat {
    --tone: #25282c;
  }

  .bsx__col--fall {
    --tone: #16181a;
    clip-path: polygon(0 0, 100% 10%, 100% 100%, 0 100%);
  }

  /* Rise: from the ground, staggered, settling into place */
  .bsx[data-state='cover'] .bsx__col {
    transform: translateY(0);
    transition: transform var(--bsx-up) var(--bs-ease) var(--d);
  }

  /* Sink: back into the ground, accelerating, in reverse order */
  .bsx[data-state='reveal'] .bsx__col {
    transform: translateY(100%);
    transition: transform var(--bsx-down) var(--bs-ease-in) calc(var(--bsx-stagger) - var(--d));
  }

  /* Slow connection: a signal line draws along the top while waiting */
  .bsx__wait {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--bs-signal);
    transform: scaleX(0);
    transform-origin: left;
  }

  .bsx[data-waiting='true'] .bsx__wait {
    animation: bsx-wait 3s var(--bs-ease) forwards;
  }

  @keyframes bsx-wait {
    to {
      transform: scaleX(0.9);
    }
  }

  /* Phones: two groups (six columns) */
  @media (max-width: 767px) {
    .bsx__col:nth-child(n + 7) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bsx {
      display: none;
    }
  }
</style>

<script>
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const columns = () => document.querySelector<HTMLElement>('[data-bs-columns]');
  const ms = (el: HTMLElement, prop: string) => parseFloat(getComputedStyle(el).getPropertyValue(prop)) || 0;

  let waitTimer = 0;

  // Raise the columns while the next page loads; the swap waits for both
  document.addEventListener('astro:before-preparation', (event) => {
    const el = columns();
    if (!el || reduced()) return;

    const load = event.loader;
    event.loader = async () => {
      el.dataset.state = 'cover';
      const up = ms(el, '--bsx-up') + ms(el, '--bsx-stagger');
      const covered = new Promise<void>((resolve) => setTimeout(resolve, up));
      waitTimer = window.setTimeout(() => (el.dataset.waiting = 'true'), up + 250);
      try {
        await Promise.all([covered, load()]);
      } finally {
        clearTimeout(waitTimer);
      }
    };
  });

  // New page is in place behind the columns: let them sink
  const sink = () => {
    const el = columns();
    if (!el || el.dataset.state !== 'cover') return;
    delete el.dataset.waiting;
    el.dataset.state = 'reveal';
    const down = ms(el, '--bsx-down') + ms(el, '--bsx-stagger');
    setTimeout(() => {
      if (el.dataset.state === 'reveal') el.dataset.state = 'idle';
    }, down + 50);
  };

  document.addEventListener('astro:after-swap', sink);
  // Safety net: never leave the page covered, e.g. if a swap was skipped
  document.addEventListener('astro:page-load', sink);
</script>
