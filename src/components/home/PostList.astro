---
/**
 * List of blog posts (blog index, categories, tags, related posts), laid
 * out as an editorial index: date on the left, then the title, category,
 * excerpt and "Read" stacked together, and the cover on its own in the text
 * column. On small screens the cover comes first. Covers share one 16:10
 * crop so different image styles still read as a set.
 */
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import { findImage } from '~/utils/images';

export interface Props {
  posts: Post[];
  /** Smaller titles, e.g. for related posts */
  compact?: boolean;
}

const { posts, compact = false } = Astro.props;

// Resolve local (~/assets/...) and remote cover images, as the post page does
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    image: (await findImage(post.image)) as ImageMetadata | string | undefined,
  }))
);
---

<ol class:list={['pl', { 'pl--compact': compact }]}>
  {
    items.map(({ post, image }) => (
      <li>
        <a class="pl__row bs-grid" href={getPermalink(post.permalink, 'post')}>
          {image && (
            <span class="pl__thumb">
              {/* Decorative: the link already reads out the post title */}
              <Image
                src={image}
                alt=""
                layout="cover"
                widths={[400, 640, 800]}
                sizes="(min-width: 900px) 30vw, 100vw"
              />
            </span>
          )}
          <span class="pl__meta bs-mono">
            <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
            {post.readingTime && <span>{post.readingTime} min read</span>}
          </span>
          <span class="pl__main">
            <span class="pl__title bs-display">{post.title}</span>
            {post.category && <span class="pl__category bs-mono">{post.category.title}</span>}
            {post.excerpt && <span class="pl__excerpt">{post.excerpt}</span>}
            <span class="pl__read bs-mono">
              Read <span aria-hidden="true">→</span>
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .pl {
    border-bottom: 1px solid var(--bs-rule);
  }

  .pl__row {
    position: relative;
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--bs-rule);
    row-gap: 12px;
    align-items: start;
    color: var(--bs-text);
  }

  /* Cover: one 16:10 crop for every post, hairline frame, square corners */
  .pl__thumb {
    grid-column: 1 / -1;
    display: block;
    overflow: hidden;
    background: var(--bs-surface);
    border: 1px solid var(--bs-rule);
    margin-bottom: 8px;
  }

  .pl__thumb :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    /* Graded into the site's monochrome, like the founder portrait; the
       colour comes back on hover */
    filter: grayscale(1) contrast(1.05);
    transition:
      transform 0.9s var(--bs-ease),
      filter 0.6s var(--bs-ease);
  }

  .pl__row:hover .pl__thumb :global(img),
  .pl__row:focus-visible .pl__thumb :global(img) {
    transform: scale(1.03);
    filter: none;
  }

  /* Signal rule that draws across on hover/focus */
  .pl__row::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    background: var(--bs-signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--bs-ease);
  }

  .pl__row:hover::before,
  .pl__row:focus-visible::before {
    transform: scaleX(1);
  }

  .pl__row:focus-visible {
    outline: 2px solid var(--bs-signal);
    outline-offset: 4px;
  }

  .pl__meta,
  .pl__main {
    grid-column: 1 / -1;
  }

  .pl__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
  }

  .pl__title {
    font-size: clamp(30px, 3.4vw, 50px);
    line-height: 1;
    text-wrap: balance;
    transition: transform 0.6s var(--bs-ease);
  }

  .pl__row:hover .pl__title {
    transform: translateX(6px);
  }

  .pl--compact .pl__title {
    font-size: clamp(24px, 2.4vw, 34px);
  }

  /* Title, category, excerpt and Read read as one unit */
  .pl__main {
    display: grid;
    justify-items: start;
    gap: 12px;
  }

  .pl__title {
    margin-bottom: 4px;
  }

  .pl__category {
    color: var(--bs-ink);
  }

  .pl__excerpt {
    font-size: 16px;
    line-height: 1.55;
    max-width: 32em;
  }

  .pl__read {
    color: var(--bs-ink);
    transition: color 0.2s;
  }

  .pl__row:hover .pl__read {
    color: var(--bs-signal);
  }

  @media (min-width: 900px) {
    /* Date | title and text | cover on its own in the text column */
    .pl__thumb {
      grid-column: 9 / -1;
      grid-row: 1;
      margin-bottom: 0;
    }

    .pl__meta {
      grid-column: 1 / span 2;
      grid-row: 1;
      flex-direction: column;
    }

    .pl__main {
      grid-column: 3 / span 5;
      grid-row: 1;
    }
  }
</style>
