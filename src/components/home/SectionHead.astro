---
/**
 * Section opener: a full-width hairline, a mono index on the left and a
 * left-aligned display heading. Replaces the centred title + subtitle
 * pattern used across the old template.
 */
export interface Props {
  index: string;
  label: string;
  title: string;
  lede?: string;
  id?: string;
}

const { index, label, title, lede, id } = Astro.props;
---

<header class="head bs-grid" data-reveal>
  <p class="head__label bs-mono">
    <span class="head__index">{index}</span>
    <span aria-hidden="true">—</span>
    {label}
  </p>
  <div class="head__body">
    <h2 class="head__title bs-display" id={id}>{title}</h2>
    {lede && <p class="head__lede bs-lede">{lede}</p>}
  </div>
</header>

<style>
  .head {
    border-top: 1px solid var(--bs-rule);
    padding-top: 20px;
    row-gap: 24px;
  }

  .head__label {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.6em;
  }

  .head__index {
    color: var(--bs-ink);
  }

  .head__body {
    grid-column: 1 / -1;
  }

  .head__title {
    font-size: clamp(44px, 6.4vw, 96px);
    max-width: 14ch;
  }

  .head__lede {
    margin-top: 24px;
  }

  @media (min-width: 900px) {
    .head__label {
      grid-column: 1 / span 3;
    }
    .head__body {
      grid-column: 4 / -1;
    }
  }
</style>
