---
/**
 * Process as rising basalt columns: each step stands a little taller than
 * the last, like stepping stones up the Causeway.
 */
import SectionHead from './SectionHead.astro';

export interface Step {
  title: string;
  description: string;
}

export interface Props {
  id?: string;
  steps: Step[];
  index?: string;
  label?: string;
  title?: string;
  lede?: string;
  /** Section heading size (see SectionHead) */
  headSize?: 'feature' | 'standard';
  /** Tight section rhythm (see .bs-section--tight) */
  tight?: boolean;
}

const {
  id = 'our-process',
  steps,
  index = '04',
  label = 'How we work',
  title = 'From idea to working product.',
  headSize = 'standard',
  tight = false,
  lede = 'A detailed spec or just a problem to solve. Either way, we find the right approach and build it in stages you can see.',
} = Astro.props;
---

<section class:list={['process bs-section', { 'bs-section--tight': tight }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="bs-wrap">
    <SectionHead id={`${id}-title`} index={index} label={label} title={title} lede={lede} size={headSize} />

    <ol class="cols" data-reveal style={`--n:${steps.length}`}>
      {
        steps.map((s, i) => (
          <li class="col" style={`--i:${i}`}>
            <div class:list={['col__stone', { 'col__stone--last': i === steps.length - 1 }]} aria-hidden="true">
              <span class="bs-mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="col__title bs-display">{s.title}</h3>
            <p class="col__desc">{s.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cols {
    margin-top: clamp(48px, 7vw, 96px);
    display: grid;
    gap: 32px;
  }

  .col {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: 20px;
    row-gap: 6px;
  }

  /* Mobile: a short column on the left that grows step by step */
  .col__stone {
    grid-row: 1 / span 2;
    width: 100%;
    height: calc(48px + var(--i) * 16px);
    align-self: start;
    background: var(--bs-ground-surface);
    border: 1px solid var(--bs-rule);
    padding: 8px;
    transform-origin: bottom;
    clip-path: polygon(0 10px, 100% 0, 100% 100%, 0 100%);
  }

  .col__stone .bs-mono {
    display: block;
    margin-top: 8px;
    color: var(--bs-ink);
  }

  .col__stone--last {
    background: var(--bs-signal);
    border-color: var(--bs-signal);
  }

  .col__stone--last .bs-mono {
    color: var(--bs-signal-ink);
  }

  .col__title {
    font-size: 28px;
    line-height: 1;
  }

  .col__desc {
    font-size: 15px;
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      align-items: end;
      gap: clamp(12px, 1.6vw, 24px);
    }

    .col {
      display: flex;
      flex-direction: column;
      height: 100%;
      justify-content: flex-end;
    }

    .col__stone {
      height: calc(120px + var(--i) * 56px);
      padding: 16px;
      clip-path: polygon(0 18px, 100% 0, 100% 100%, 0 100%);
      margin-bottom: 24px;
    }

    .col__stone .bs-mono {
      margin-top: 14px;
    }

    .col__title {
      font-size: clamp(26px, 2.2vw, 34px);
      margin-bottom: 12px;
      min-height: 2em;
    }

    .col__desc {
      min-height: 7.5em;
    }
  }

  /* Column rise: stones grow from the ground in sequence */
  .col__stone {
    transition: transform var(--bs-dur-rise) var(--bs-ease);
    transition-delay: calc(var(--i) * 90ms);
  }

  :global(.bs-js) .cols:not(.is-in) .col__stone {
    transform: scaleY(0.08);
  }

  /* The list itself should not fade; only the stones rise */
  :global(.bs-js) .cols[data-reveal]:not(.is-in) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .col__stone {
      transition: none;
    }
    :global(.bs-js) .cols:not(.is-in) .col__stone {
      transform: none;
    }
  }
</style>
