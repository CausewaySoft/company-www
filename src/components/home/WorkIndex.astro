---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';

export interface Project {
  title: string;
  kind: string;
  description: string;
  outcome: string;
  tags: string[];
  href: string;
  linkLabel: string;
  image: { src: ImageMetadata; alt: string };
}

export interface Props {
  id?: string;
  projects: Project[];
  index?: string;
  label?: string;
  title?: string;
  lede?: string;
  /** Section heading size (see SectionHead) */
  headSize?: 'feature' | 'standard';
  /** Number of the first project's "Fig." caption, following the page's figures */
  figStart?: number;
}

const {
  id = 'work',
  projects,
  index = '02',
  label = 'Selected work',
  title = 'Built, shipped and in use.',
  headSize = 'standard',
  figStart,
  lede = 'Two products, live today: one is built for AI agents to use, the other works fully offline.',
} = Astro.props;
---

<section class="work bs-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="bs-wrap">
    <SectionHead id={`${id}-title`} index={index} label={label} title={title} lede={lede} size={headSize} />

    <ol class="work__list">
      {
        projects.map((p, i) => (
          <li class:list={['work__item bs-grid', { 'work__item--flip': i % 2 === 1 }]} data-reveal>
            <figure class="work__figure">
              <a class="work__media" href={p.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <Image
                  src={p.image.src}
                  alt={p.image.alt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                />
              </a>
              {figStart !== undefined && (
                <figcaption class="work__caption bs-mono">
                  <span>Fig. {String(figStart + i).padStart(2, '0')}</span>
                  <span>{p.title}</span>
                </figcaption>
              )}
            </figure>
            <div class="work__text">
              <p class="bs-mono">
                <span class="work__num">{String(i + 1).padStart(2, '0')}</span> / {p.kind}
              </p>
              <h3 class="work__title bs-display">{p.title}</h3>
              <p class="work__desc">{p.description}</p>
              <dl class="work__facts">
                <div>
                  <dt class="bs-mono">Outcome</dt>
                  <dd>{p.outcome}</dd>
                </div>
                <div>
                  <dt class="bs-mono">Scope</dt>
                  <dd class="work__tags">{p.tags.join(' · ')}</dd>
                </div>
              </dl>
              <a class="bs-link" href={p.href} target="_blank" rel="noopener">
                {p.linkLabel} <span aria-hidden="true">↗</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .work__list {
    margin-top: clamp(48px, 7vw, 96px);
  }

  .work__item {
    row-gap: 28px;
    padding-block: clamp(32px, 5vw, 64px);
    border-top: 1px solid var(--bs-rule);
    align-items: center;
  }

  .work__figure,
  .work__text {
    grid-column: 1 / -1;
  }

  /* Every project sits on the same mount, so screenshots exported on
     different backgrounds still read as one set of plates */
  .work__media {
    display: block;
    overflow: hidden;
    padding: clamp(12px, 2.4vw, 32px);
    background: var(--bs-surface);
    border: 1px solid var(--bs-rule);
  }

  .work__caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
  }

  .work__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.9s var(--bs-ease);
  }

  .work__item:hover .work__media img {
    transform: scale(1.025);
  }

  .work__num {
    color: var(--bs-ink);
  }

  .work__title {
    margin-top: 16px;
    font-size: clamp(40px, 4.6vw, 68px);
  }

  .work__desc {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.55;
    max-width: 36em;
  }

  .work__facts {
    margin-block: 28px 32px;
    border-top: 1px solid var(--bs-rule);
  }

  .work__facts > div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--bs-rule);
  }

  .work__facts dt {
    padding-top: 2px;
  }

  .work__facts dd {
    color: var(--bs-ink);
    font-size: 15px;
  }

  .work__tags {
    font-family: var(--bs-font-mono);
    font-size: 13px !important;
  }

  @media (min-width: 1024px) {
    .work__figure {
      grid-column: 1 / span 7;
    }
    .work__text {
      grid-column: 9 / -1;
    }
    .work__item--flip .work__figure {
      grid-column: 6 / -1;
      grid-row: 1;
    }
    .work__item--flip .work__text {
      grid-column: 1 / span 4;
      grid-row: 1;
    }
  }
</style>
