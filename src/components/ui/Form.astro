---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

const {id, action, inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props;
---

<form
  id={id}
  role='form'
>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '' }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium mb-3">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    // this neeeds to be refactored like inputs above
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium mb-3">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  <!-- {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  } -->

  {
    button && (
      <div class="mt-5 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
         {disclaimer && ( <p class="text-sm text-gray-600 dark:text-gray-400">{disclaimer.label}</p>)}
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }


  <!-- Success and Error messages -->

  <div id="form-success" class="hidden mt-8 flex items-center bg-green-500 rounded-lg text-white text-sm font-bolddd px-4 py-3" role="alert">
    <Icon name="tabler:rocket" class="w-10 h-10 inline-block mr-3" />
    <p>Message sent successfully! Thank you!</p>
  </div>

  <div id="form-error" class="hidden mt-8 flex items-center bg-red-500 rounded-lg text-white text-sm font-bolddd px-4 py-3" role="alert">
    <Icon name="tabler:exclamation-circle" class="w-10 h-10 inline-block mr-3" />
    <p>There was an error sending your message.<br/>Please contact us directly at the email addresses listed below.</p>
  </div>

</form>
